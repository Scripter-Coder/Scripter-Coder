	-- Unlock Glove Button
	PimTab:Button({
		Title = "Unlock Glove",
		Icon = "solar:lock-unlocked-bold",
		Justify = "Center",
		Color = Color3.fromHex("#10C550"),
		Callback = function()
			local Player = game.Players.LocalPlayer
			local Character = Player.Character or Player.CharacterAdded:Wait()
			local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")
			local Backpack = Player:WaitForChild("Backpack")
			local Event = game:GetService("ReplicatedStorage").Remotes.KeyLockAttempt
			
			HumanoidRootPart.CFrame = CFrame.new(-147, 4, -128)
			task.wait(0.1)
			
			local LOCK_KEYS = {
				BlackKeyLock = "FieryKey",
				BlueKeyLock = "SeerKey",
				GreenKeyLock = "RuneKey",
				PurpleKeyLock = "SilverKey",
				RedKeyLock = "RubyKey"
			}
			
			local function equipKey(keyName)
				for _, item in ipairs(Character:GetChildren()) do
					if item:IsA("Tool") then
						item.Parent = Backpack
					end
				end
				task.wait(0.1)
				
				for _, item in ipairs(Backpack:GetChildren()) do
					if item:IsA("Tool") and item.Name == keyName then
						item.Parent = Character
						task.wait(0.2)
						return true
					end
				end
				return false
			end
			
			local function fireKeyLock(lockName)
				local lockModel = workspace.FinalRoom:FindFirstChild(lockName)
				if not lockModel then
					warn("Lock not found: " .. lockName)
					return false
				end
				Event:FireServer(lockModel)
				print("✅ Fired KeyLockAttempt for: " .. lockName)
				return true
			end
			
			local successCount = 0
			for lockName, keyName in pairs(LOCK_KEYS) do
				local hasKey = false
				for _, item in ipairs(Backpack:GetChildren()) do
					if item:IsA("Tool") and item.Name == keyName then
						hasKey = true
						break
					end
				end
				
				if not hasKey then
					print("⚠️ Missing key: " .. keyName)
					continue
				end
				
				equipKey(keyName)
				fireKeyLock(lockName)
				successCount = successCount + 1
				task.wait(0.3)
			end
			
			WindUI:Notify({
				Title = "✅ Unlock Attempt",
				Content = "Processed " .. successCount .. "/5 locks",
				Icon = "check",
				Duration = 3,
			})
		end,
	})

