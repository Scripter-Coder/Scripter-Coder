				if not finalRing then
					finalRing = workspace:WaitForChild("StartCorridor"):WaitForChild("FinalRing")
				end
				
				local trigger = finalRing:FindFirstChild("Trigger")
				if trigger then
					HumanoidRootPart.CFrame = trigger.CFrame
					print("✅ Teleported to Trigger!")
				else
					trigger = finalRing:WaitForChild("Trigger")
					HumanoidRootPart.CFrame = trigger.CFrame
					print("✅ Teleported to Trigger!")
				end
			end
			
			teleportToTrigger()
			
			WindUI:Notify({
				Title = "✅ Complete!",
				Content = "All tasks completed!",
				Icon = "check",
				Duration = 3,
			})
		end,
	})

