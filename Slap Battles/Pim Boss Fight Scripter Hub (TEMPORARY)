	-- Collect All Keys Button
	PimTab:Button({
		Title = "Collect All Keys",
		Icon = "solar:key-bold",
		Justify = "Center",
		Color = Color3.fromHex("#ECA201"),
		Callback = function()
			local Player = game.Players.LocalPlayer
			local Character = Player.Character or Player.CharacterAdded:Wait()
			local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")
			
			local KEY_TYPES = {
				"RuneKey", "SilverKey", "SeerKey", "RubyKey", "FieryKey"
			}
			
			local openedChests = {}
			local totalOpened = 0
			local requiredChests = 5
			
			local function hasTargetKey(chest)
				for _, keyType in ipairs(KEY_TYPES) do
					if chest:GetAttribute("ItemId") == keyType then
						return keyType
					end
				end
				return nil
			end
			
			local function findAllChests()
				local chests = {}
				for _, obj in ipairs(workspace:GetDescendants()) do
					if obj:IsA("Model") and obj.Name == "BasicChest" then
						table.insert(chests, obj)
					end
				end
				return chests
			end
			
			local function openChest(chest)
				local keyType = hasTargetKey(chest)
				if not keyType then return false end
				if openedChests[keyType] then
					print("Already opened: " .. keyType)
					return false
				end
				
				local basePart = chest:FindFirstChild("Base")
				if not basePart then
					warn("Chest missing 'Base' part")
					return false
				end
				
				local prompt = basePart:FindFirstChild("ProximityPrompt")
				if not prompt then
					warn("Chest missing ProximityPrompt")
					return false
				end
				
				HumanoidRootPart.CFrame = basePart.CFrame + Vector3.new(0, 2, 0)
				task.wait(0.2)
				fireproximityprompt(prompt)
				task.wait(0.4)
				
				openedChests[keyType] = true
				totalOpened = totalOpened + 1
				print("Opened " .. keyType .. " chest! (" .. totalOpened .. "/5)")
				return true
			end
			
			local allChests = findAllChests()
			print("Found " .. #allChests .. " BasicChests")
			
			for _, chest in ipairs(allChests) do
				if totalOpened >= requiredChests then break end
				local keyType = hasTargetKey(chest)
				if keyType and not openedChests[keyType] then
					openChest(chest)
					task.wait(0.5)
				end
			end
			
			if totalOpened >= requiredChests then
				WindUI:Notify({
					Title = "✅ Success!",
					Content = "Opened all 5 chests!",
					Icon = "check",
					Duration = 3,
				})
			else
				WindUI:Notify({
					Title = "⚠️ Incomplete",
					Content = "Only opened " .. totalOpened .. "/5 chests",
					Icon = "alert-triangle",
					Duration = 3,
				})
			end
		end,
	})

