			local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")
			
			local teleportPosition = Vector3.new(-147, 4, -128)
			HumanoidRootPart.CFrame = CFrame.new(teleportPosition)
			task.wait(0.2)
			
			local gloveVisual = workspace:FindFirstChild("GloveVisual")
			if not gloveVisual then
				WindUI:Notify({
					Title = "❌ Error",
					Content = "GloveVisual not found!",
					Icon = "alert-circle",
					Duration = 3,
				})
				return
			end
			
			local prompt = gloveVisual:FindFirstChild("ProximityPrompt")
			if not prompt then
				WindUI:Notify({
					Title = "❌ Error",
					Content = "No ProximityPrompt found!",
					Icon = "alert-circle",
					Duration = 3,
				})
				return
			end
			
			local attempts = 0
			local maxAttempts = 100
			
			while prompt and prompt.Parent and prompt.Enabled ~= false do
				attempts = attempts + 1
				if not prompt or not prompt.Parent or prompt.Enabled == false then
					break
				end
				
				pcall(function()
					fireproximityprompt(prompt)
					print("[" .. attempts .. "] 🔥 Fired ProximityPrompt")
				end)
				
				task.wait(0.3)
				if attempts >= maxAttempts then
					print("⚠️ Max attempts reached")
					break
				end
			end
			
			if not prompt or not prompt.Parent then
				WindUI:Notify({
					Title = "✅ Success!",
					Content = "Glove claimed successfully!",
					Icon = "check",
					Duration = 3,
				})
			end
		end,
	})

