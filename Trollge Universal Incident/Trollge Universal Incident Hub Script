local function StartChestsFarmLoop()
    log("StartFarmLoop: loop started")

    while ChestFarmEnabled do
        log("---- new iteration ----")

        local targetChest, chestType = GetBestAvailableChest()

        if not targetChest then
            warn_("StartFarmLoop: no chest found, waiting", FlyDelay, "s")
            WindUI:Notify({
                Title = "Warning",
                Content = "No chests found!",
                Image = "rbxassetid://4483345998",
                Duration = 1
            })
            task.wait(FlyDelay)
        else
            local arrived = FlyToChest(targetChest)

            if arrived and ChestFarmEnabled then
                log("StartFarmLoop: arrived, waiting 0.05s before spam")
                task.wait(0.05)
                SpamChestPrompt(targetChest)
            else
                log("StartFarmLoop: did not arrive (cancelled/off)")
            end

            if ChestFarmEnabled then
                log("StartFarmLoop: waiting", FlyDelay, "s before next chest")
                task.wait(FlyDelay)
            end
        end
    end

    log("StartFarmLoop: loop ended (toggled off)")
end

