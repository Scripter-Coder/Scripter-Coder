local function SpamChestPrompt(chest)
    log("SpamChestPrompt: start on", chest and chest:GetFullName() or "nil")

    local proximityPrompt = chest:FindFirstChildOfClass("ProximityPrompt")
    if not proximityPrompt then
        warn_("SpamChestPrompt: NO ProximityPrompt on", chest:GetFullName())
        return false
    end

    proximityPrompt.HoldDuration = 0

    local fired = 0
    for i = 1, SpamAmount do
        if not ChestFarmEnabled then
            log("SpamChestPrompt: toggled off mid-spam, fired", fired, "times")
            return false
        end
        local ok, err = pcall(function()
            fireproximityprompt(proximityPrompt)
        end)
        if ok then
            fired = fired + 1
        else
            warn_("SpamChestPrompt: fireproximityprompt error:", err)
        end
        task.wait(SpamDelay)
    end

    log("SpamChestPrompt: done, fired", fired, "/", SpamAmount, "times")
    return true
end

local function GetChestsByType(chestType)
    local chestsFolder = workspace:FindFirstChild("chests")
    if not chestsFolder then
        warn_("GetChestsByType: workspace.chests NOT FOUND")
        return {}
    end

    local chests = {}
    for _, chest in pairs(chestsFolder:GetDescendants()) do
        if chest:IsA("MeshPart") and chest.Name == chestType then
            local prompt = chest:FindFirstChildOfClass("ProximityPrompt")
            if prompt then
                prompt.HoldDuration = 0
                table.insert(chests, chest)
            else
                warn_("GetChestsByType:", chest:GetFullName(), "has no ProximityPrompt, skipped")
            end
        end
    end

    log("GetChestsByType:", chestType, "-> found", #chests)
    return chests
end

local function GetClosestChest(chestList)
    local player = game.Players.LocalPlayer
    local character = player.Character
    if not character then
        warn_("GetClosestChest: no character")
        return nil
    end

    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        warn_("GetClosestChest: no HumanoidRootPart")
        return nil
    end

    local closest, closestDist = nil, math.huge
    for _, chest in ipairs(chestList) do
        local dist = (chest.Position - hrp.Position).Magnitude
        if dist < closestDist then
            closest, closestDist = chest, dist
        end
    end

    if closest then
        log("GetClosestChest: closest =", closest:GetFullName(), "dist =", math.floor(closestDist))
    else
        warn_("GetClosestChest: empty list")
    end
    return closest
end

local function GetBestAvailableChest()
    log("GetBestAvailableChest: scanning priority chests...")

    for _, chestType in ipairs(ChestPriority) do
        local chests = GetChestsByType(chestType)
        if #chests > 0 then
            local pick = chests[math.random(1, #chests)]
            log("GetBestAvailableChest: picked PRIORITY", chestType, "->", pick:GetFullName())
            return pick, chestType
        end
    end

    log("GetBestAvailableChest: no priority chests, falling back to regular...")

    local regularChests = {}
    for _, name in ipairs(RegularChestNames) do
        for _, c in ipairs(GetChestsByType(name)) do
            table.insert(regularChests, c)
        end
    end

    if #regularChests > 0 then
        local closest = GetClosestChest(regularChests)
        log("GetBestAvailableChest: picked CLOSEST regular ->", closest and closest:GetFullName() or "nil")
        return closest, "Chest_p"
    end

    warn_("GetBestAvailableChest: NO CHESTS AT ALL")
    return nil, nil
end

-- =====================================================================
-- Tween fly-to
-- =====================================================================

local function CancelActiveTween()
    if ActiveTween then
        log("CancelActiveTween: cancelling current tween")
        pcall(function() ActiveTween:Cancel() end)
        ActiveTween = nil
    end
end

local function FlyToChest(chest)
    log("FlyToChest: target =", chest and chest:GetFullName() or "nil")

    local player = game.Players.LocalPlayer
    local character = player.Character
    if not character then
        warn_("FlyToChest: no character")
        return false
    end

    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        warn_("FlyToChest: no HumanoidRootPart")
        return false
    end

    local startPos = hrp.Position
    local targetPos = chest.Position + Vector3.new(0, 5, 0)
    local targetCFrame = CFrame.new(targetPos) * (hrp.CFrame - hrp.CFrame.Position)

    local distance = (targetPos - startPos).Magnitude
    local duration = math.max(distance / FlySpeed, 0.05)

    log("FlyToChest: distance =", math.floor(distance), "duration =", string.format("%.2f", duration), "s")

    CancelActiveTween()

    local tweenInfo = TweenInfo.new(
        duration,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    )

    local tween = game:GetService("TweenService"):Create(hrp, tweenInfo, { CFrame = targetCFrame })
    ActiveTween = tween
    tween:Play()

    local startTime = tick()
    while ActiveTween == tween and tween.PlaybackState == Enum.PlaybackState.Playing do
        if not ChestFarmEnabled then
            log("FlyToChest: toggled off mid-flight")
            CancelActiveTween()
            return false
        end
        if tick() - startTime > duration + 2 then
            warn_("FlyToChest: timeout exceeded, cancelling")
            CancelActiveTween()
            break
        end
        task.wait(0.03)
    end

    ActiveTween = nil
    log("FlyToChest: arrived at", chest:GetFullName())
    return true
end

