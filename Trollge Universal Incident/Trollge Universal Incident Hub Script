-- Variables
local AutoUseEnabled = false
local AutoUseConnection = nil
local UseDelay = 0.01  -- Delay between using items (seconds)

-- Item names to look for
local TargetItems = {
    "Chest",
    "Magic Egg"
}

-- Function to find items in backpack/hotbar
local function FindTargetItems()
    local player = game.Players.LocalPlayer
    local backpack = player:FindFirstChild("Backpack")
    local character = player.Character
    local items = {}
    
    -- Check Backpack
    if backpack then
        for _, item in pairs(backpack:GetChildren()) do
            for _, targetName in pairs(TargetItems) do
                if item.Name == targetName or item.Name:find(targetName) then
                    table.insert(items, item)
                    break
                end
            end
        end
    end
    
    -- Check Character (already equipped tools)
    if character then
        for _, item in pairs(character:GetChildren()) do
            if item:IsA("Tool") then
                for _, targetName in pairs(TargetItems) do
                    if item.Name == targetName or item.Name:find(targetName) then
                        table.insert(items, item)
                        break
                    end
                end
            end
        end
    end
    
    return items
end

-- Function to equip a tool
local function EquipTool(tool)
    local player = game.Players.LocalPlayer
    local character = player.Character
    if not character then return false end
    
    -- If tool is in backpack, equip it
    if tool.Parent == player:FindFirstChild("Backpack") then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:EquipTool(tool)
            task.wait(0.01)  -- Wait for equip animation
            return true
        end
    end
    
    -- If tool is already in character, it's equipped
    if tool.Parent == character then
        return true
    end
    
    return false
end

-- Function to use/activate an item
local function UseItem(item)
    -- Method 1: Fire Tool's activated event
    if item:IsA("Tool") then
        -- Try to activate the tool
        local activatedEvent = item:FindFirstChild("Activated")
        if activatedEvent then
            activatedEvent:FireServer()
        end
        
        -- Try clicking the tool
        local clickDetector = item:FindFirstChildOfClass("ClickDetector")
        if clickDetector then
            clickDetector:Click()
        end
        
        -- Try firing remote events commonly used for opening
        local remote = item:FindFirstChild("RemoteEvent") or item:FindFirstChild("OpenEvent")
        if remote then
            remote:FireServer()
        end
        
        -- Try using tool's function
        if item.Activate then
            item:Activate()
        end
    end
    
    -- Method 2: Look for ProximityPrompt
    local proximityPrompt = item:FindFirstChildOfClass("ProximityPrompt")
    if proximityPrompt then
        proximityPrompt.HoldDuration = 0
        fireproximityprompt(proximityPrompt)
    end
    
    -- Method 3: Try clicking the item itself
    local clickDetector = item:FindFirstChildOfClass("ClickDetector")
    if clickDetector then
        clickDetector:Click()
    end
    
    -- Method 4: Fire all remote events as a last resort
    for _, child in pairs(item:GetChildren()) do
        if child:IsA("RemoteEvent") or child:IsA("BindableEvent") then
            child:FireServer()
        end
    end
    
    return true
end

-- Function to parent item to character (force equip)
local function ForceEquipItem(item)
    local player = game.Players.LocalPlayer
    local character = player.Character
    if not character then return false end
    
    -- If item is a tool, equip it properly
    if item:IsA("Tool") then
        -- Unequip current tool first
        local currentTool = character:FindFirstChildOfClass("Tool")
        if currentTool then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid:UnequipTool(currentTool)
                task.wait(0.01)
            end
        end
        
        -- Equip new tool
        if item.Parent ~= character then
            item.Parent = character
            task.wait(0.01)
        end
        
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:EquipTool(item)
        end
        return true
    end
    
    return false
end

-- Main auto-use loop
local function StartAutoUseLoop()
    while AutoUseEnabled do
        local items = FindTargetItems()
        
        if #items == 0 then
            -- No items found, wait and check again
            task.wait(UseDelay)
        else
            for _, item in pairs(items) do
                if not AutoUseEnabled then break end
                
                -- Equip the item
                local equipped = EquipTool(item)
                if not equipped then
                    ForceEquipItem(item)
                end
                
                -- Wait a moment after equipping
                task.wait(0.01)
                
                -- Use/activate the item
                UseItem(item)
                
                -- Show notification for which item was used
                WindUI:Notify({
                    Title = "Used Item",
                    Content = "Used: " .. item.Name,
                    Image = "rbxassetid://4483345998",
                    Duration = 1
                })
                
                -- Wait before using next item
                task.wait(UseDelay)
            end
        end
    end
end

