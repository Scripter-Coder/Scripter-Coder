-- ========== CRATE DETECTION ==========

-- Check if a tool is a crate
local function isCrateTool(tool)
    if not tool:IsA("Tool") then
        return false
    end
    
    -- Check if name contains "Crate" (case-insensitive)
    local toolName = string.lower(tool.Name)
    return string.find(toolName, "crate") ~= nil
end

-- Get all crate tools
local function getCrateTools()
    allCrates = {}
    
    -- Check backpack
    for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
        if isCrateTool(tool) then
            table.insert(allCrates, {
                Name = tool.Name,
                Tool = tool,
                Type = "Backpack"
            })
        end
    end
    
    -- Check character (already equipped)
    if LocalPlayer.Character then
        for _, tool in pairs(LocalPlayer.Character:GetChildren()) do
            if tool:IsA("Tool") and isCrateTool(tool) then
                table.insert(allCrates, {
                    Name = tool.Name,
                    Tool = tool,
                    Type = "Equipped"
                })
            end
        end
    end
    
    return allCrates
end

-- Equip a crate tool
local function equipCrateTool(crateData)
    if not LocalPlayer.Character then
        return false
    end
    
    local humanoid = LocalPlayer.Character:FindFirstChild("Humanoid")
    if not humanoid then
        return false
    end
    
    -- If already equipped
    if crateData.Type == "Equipped" then
        return true
    end
    
    -- Check if tool exists
    if not crateData.Tool or not crateData.Tool.Parent then
        return false
    end
    
    -- Equip the tool
    humanoid:EquipTool(crateData.Tool)
    
    -- Wait for equip
    for i = 1, 20 do
        if crateData.Tool.Parent == LocalPlayer.Character then
            return true
        end
        task.wait(0.05)
    end
    
    return false
end

-- Get random crate
local function getRandomCrate()
    local crates = getCrateTools()
    if #crates > 0 then
        return crates[math.random(1, #crates)]
    end
    return nil
end

-- Open crate with name argument
local function openCrate(crateData)
    -- First equip the crate
    local equipped = equipCrateTool(crateData)
    if not equipped then
        return false
    end
    
    -- Small delay after equipping
    task.wait(0.2)
    
    -- Open with crate name as argument
    local args = {crateData.Name}
    OpenCrateRemote:FireServer(unpack(args))
    return true
end

