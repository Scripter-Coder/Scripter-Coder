local function getAdminChestTasks()
    local contentFrame = workspace:FindFirstChild("ScriptedMap")
        and workspace.ScriptedMap:FindFirstChild("AdminChest")
        and workspace.ScriptedMap.AdminChest:FindFirstChild("Sign")
        and workspace.ScriptedMap.AdminChest.Sign:FindFirstChild("Main")
        and workspace.ScriptedMap.AdminChest.Sign.Main:FindFirstChild("SurfaceGui")
        and workspace.ScriptedMap.AdminChest.Sign.Main.SurfaceGui:FindFirstChild("Content")
    
    if not contentFrame then
        return "❌ Admin Chest quests not found!"
    end
    
    local result = "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    result = result .. "              📋 ADMIN CHEST TASKS 📋\n"
    result = result .. "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    
    for i = 1, 6 do
        local frame = contentFrame:FindFirstChild(tostring(i))
        if frame then
            local display = frame:FindFirstChild("Display")
            if display and display:IsA("TextLabel") then
                local text = display.Text or "Unknown"
                if text:find("<s>") then
                    text = text:gsub("<s>", ""):gsub("</s>", "")
                    result = result .. "✅ Task " .. i .. " = " .. text .. "\n"
                else
                    result = result .. "❌ Task " .. i .. " = " .. text .. "\n"
                end
            else
                result = result .. "❌ Task " .. i .. " = Display not found\n"
            end
        else
            result = result .. "❌ Task " .. i .. " = Frame not found\n"
        end
    end
    
    result = result .. "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    return result
end

