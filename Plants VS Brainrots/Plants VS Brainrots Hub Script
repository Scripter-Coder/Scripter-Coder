    Default = false,
    Callback = function(Value)
        _G.AutoBuyEnabled = Value
        
        if Value then
            task.spawn(function()
                while _G.AutoBuyEnabled do
                    -- Buy ALL items from the combined list
                    for _, itemName in ipairs(allStuffList) do
                        if not _G.AutoBuyEnabled then break end
                        pcall(function()
                            -- Check which remote to use based on item type
                            if itemName:find("Seed") then
                                BuyItemRemote:FireServer(itemName, true)
                            elseif itemName == "Water Bucket" or itemName == "Frost Grenade" or 
                                   itemName == "Banana Gun" or itemName == "Frost Blower" or
                                   itemName == "Carrot Launcher" or itemName == "Battery Pack" or
                                   itemName == "Explosive Cannon" then
                                BuyGearRemote:FireServer(itemName, true)
                            else
                                -- Season 8 items
                                SeasonShopRemote:FireServer(itemName, true)
                            end
                        end)
                        task.wait(0.2)
                    end
                    task.wait(0.3)
                end
            end)
            
            OrionLib:MakeNotification({
                Name = "Auto Buy Enabled",
                Content = "Buying ALL items from all categories!",
                Image = "rbxassetid://4483345998",
                Time = 2
            })
        else
            OrionLib:MakeNotification({
                Name = "Auto Buy Disabled",
                Content = "All auto-buy systems stopped!",
                Image = "rbxassetid://7743878857",
                Time = 2
            })
        end
    end
})

