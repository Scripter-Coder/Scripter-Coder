_G.GiftCooldown = 1 -- 1 second cooldown
_G.IsGifting = false

-- Remote
local GiftItemRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GiftItem")

-- ========== COOLDOWN FUNCTIONS ==========
local function canGift()
    local currentTime = tick()
    local timeSinceLastGift = currentTime - _G.LastGiftTime
    return timeSinceLastGift >= _G.GiftCooldown and not _G.IsGifting
end

local function updateGiftTime()
    _G.LastGiftTime = tick()
    _G.IsGifting = false
end

local function getRemainingCooldown()
    local currentTime = tick()
    local timeSinceLastGift = currentTime - _G.LastGiftTime
    local remaining = _G.GiftCooldown - timeSinceLastGift
    return math.max(0, remaining)
end

-- ========== BASIC FUNCTIONS ==========

-- Get all players
local function getAllPlayers()
    local playerList = {"None"}
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= Players.LocalPlayer then
            table.insert(playerList, player.Name)
        end
    end
    return playerList
end

-- Get all tools - FIXED VERSION
local function getAllTools()
    local LocalPlayer = Players.LocalPlayer
    local tools = {}
    
    -- First check if LocalPlayer exists
    if not LocalPlayer then
        warn("LocalPlayer is nil!")
        return tools
    end
    
    -- Check if Backpack exists
    if not LocalPlayer:FindFirstChild("Backpack") then
        warn("Backpack not found!")
        return tools
    end
    
    -- Check backpack
    for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            table.insert(tools, {
                Name = tool.Name,
                Object = tool,
                Type = "Backpack"
            })
        end
    end
    
    -- Check character
    if LocalPlayer.Character then
        for _, tool in pairs(LocalPlayer.Character:GetChildren()) do
            if tool:IsA("Tool") then
                table.insert(tools, {
                    Name = tool.Name,
                    Object = tool,
                    Type = "Equipped"
                })
            end
        end
    end
    
    -- Debug: Print found tools
    print("[DEBUG] Found " .. #tools .. " tools:")
    for i, tool in ipairs(tools) do
        print("[DEBUG] " .. i .. ": " .. tool.Name .. " (" .. tool.Type .. ")")
    end
    
    return tools
end

-- Get all tools with a specific rarity
local function getToolsByRarity(rarity)
    local LocalPlayer = Players.LocalPlayer
    local backpackGui = LocalPlayer.PlayerGui:FindFirstChild("BackpackGui")
    if not backpackGui then return {} end
    
    local backpack = backpackGui:FindFirstChild("Backpack")
    if not backpack then return {} end
    
    local toolsFound = {}
    local allTools = getAllTools()
    
    -- Function to search recursively
    local function searchForRarity(obj)
        if obj:IsA("TextLabel") and obj.Name == "ToolName" then
            local rarityObj = obj:FindFirstChild(rarity)
            if rarityObj then
                local toolName = obj.Text
                for _, toolData in pairs(allTools) do
                    if toolData.Name == toolName then
                        table.insert(toolsFound, toolData)
                        break
                    end
                end
            end
        end
        
        for _, child in pairs(obj:GetChildren()) do
            searchForRarity(child)
        end
    end
    
    searchForRarity(backpack)
    return toolsFound
end

-- Get random tool by rarity
local function getRandomToolByRarity(rarity)
    local tools = getToolsByRarity(rarity)
    if #tools == 0 then
        return nil
    end
    return tools[math.random(1, #tools)]
end

-- Get random tool from all tools
local function getRandomTool()
    local tools = getAllTools()
    if #tools == 0 then
        return nil
    end
    return tools[math.random(1, #tools)]
end

-- Simple equip function
local function equipToolSimple(toolObject)
    local LocalPlayer = Players.LocalPlayer
    
    -- Wait for character
    for i = 1, 10 do
        if LocalPlayer.Character then
            break
        end
        task.wait(0.1)
    end
    
    if not LocalPlayer.Character then
        return false
    end
    
    local character = LocalPlayer.Character
    local humanoid = character:FindFirstChild("Humanoid")
    
    if not humanoid then
        return false
    end
    
    -- If already equipped
    if toolObject.Type == "Equipped" then
        return true
    end
    
    -- Check if tool still exists
    if not toolObject.Object or not toolObject.Object.Parent then
        return false
    end
    
    -- Equip the tool
    humanoid:EquipTool(toolObject.Object)
    
    -- Wait for equip
    for i = 1, 5 do
        if toolObject.Object.Parent == character then
            task.wait(0.05)
            return true
        end
        task.wait(0.1)
    end
    
    return false
end

-- Gift selected tool
local function giftSelectedItem()
    if not _G.SelectedPlayer or _G.SelectedPlayer == "None" then
        return false, "No player selected"
    end
    
    if not _G.SelectedTool or _G.SelectedTool == "None" then
        return false, "No tool selected"
    end
    
    -- Check cooldown
    if not canGift() then
        local remaining = getRemainingCooldown()
        return false, "Cooldown: " .. string.format("%.1f", remaining) .. "s"
    end
    
    _G.IsGifting = true
    
    local tools = getAllTools()
    local selectedToolObj = nil
    
    -- Find the selected tool
    for _, toolData in pairs(tools) do
        if toolData.Name == _G.SelectedTool then
            selectedToolObj = toolData
            break
        end
    end
    
    if not selectedToolObj then
        _G.IsGifting = false
        return false, "Tool not found"
    end
    
    -- Equip the tool
    if not equipToolSimple(selectedToolObj) then
        _G.IsGifting = false
        return false, "Failed to equip"
    end
    
    task.wait(0.05) -- Very short wait after equip
    
    -- Make sure tool is in character
    local LocalPlayer = Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then
        _G.IsGifting = false
        return false, "No character"
    end
    
    local toolInCharacter = character:FindFirstChild(_G.SelectedTool)
    if not toolInCharacter then
        _G.IsGifting = false
        return false, "Tool not equipped"
    end
    
    -- Send gift
    local args = {
        {
            Item = toolInCharacter,
            ToGift = _G.SelectedPlayer
        }
    }
    
    local success = pcall(function()
        GiftItemRemote:FireServer(unpack(args))
    end)
    
    if success then
        updateGiftTime()
    else
        _G.IsGifting = false
    end
    
    return success, success and "Gifted" or "Gift failed"
end

