-- ========== HEART ICON DETECTION ==========

local heartIconCache = {}
local lastCacheUpdate = 0
local CACHE_DURATION = 1

-- Extract tool identifier from GUI button
local function extractToolIdentifier(button)
    local identifier = nil
    
    -- Check attributes
    local possibleAttrs = {"ID", "ToolID", "ItemID", "SeedID", "ToolName", "ItemName"}
    for _, attr in pairs(possibleAttrs) do
        local value = button:GetAttribute(attr)
        if value then
            identifier = tostring(value)
            break
        end
    end
    
    -- Check button name for ID pattern
    if not identifier then
        local idPattern = "(%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x)"
        local foundID = string.match(button.Name, idPattern)
        if foundID then
            identifier = foundID
        end
    end
    
    -- Check button text
    if not identifier and button:IsA("TextButton") then
        local text = button.Text
        if text and text ~= "" and #text > 3 then
            identifier = text
        end
    end
    
    -- Use button name
    if not identifier then
        identifier = button.Name
    end
    
    return identifier
end

-- Scan GUI for HeartIcons
local function scanGUIForHeartIcons(guiObject)
    for _, child in pairs(guiObject:GetDescendants()) do
        if child:IsA("TextButton") then
            local heartIcon = child:FindFirstChild("HeartIcon")
            if heartIcon and heartIcon:IsA("ImageLabel") then
                local toolIdentifier = extractToolIdentifier(child)
                if toolIdentifier then
                    heartIconCache[toolIdentifier] = true
                end
            end
        end
    end
end

-- Scan all GUIs for HeartIcons
local function scanAllGUIsForHeartIcons()
    local currentTime = tick()
    
    if currentTime - lastCacheUpdate > CACHE_DURATION then
        heartIconCache = {}
        
        -- Check PlayerGui
        local playerGui = LocalPlayer:WaitForChild("PlayerGui")
        for _, screenGui in pairs(playerGui:GetChildren()) do
            if screenGui:IsA("ScreenGui") then
                scanGUIForHeartIcons(screenGui)
            end
        end
        
        -- Check CoreGui
        local coreGui = game:GetService("CoreGui")
        for _, screenGui in pairs(coreGui:GetChildren()) do
            if screenGui:IsA("ScreenGui") then
                scanGUIForHeartIcons(screenGui)
            end
        end
        
        lastCacheUpdate = currentTime
    end
    
    return heartIconCache
end

-- Check if tool has HeartIcon
local function hasHeartIcon(toolIdentifier)
    scanAllGUIsForHeartIcons()
    return heartIconCache[toolIdentifier] == true
end

-- ========== TOOL MANAGEMENT ==========

-- Get all tools
local function getAllTools()
    local tools = {}
    
    for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local identifier = tool:GetAttribute("ID") or tool.Name
            table.insert(tools, {
                Name = tool.Name,
                Tool = tool,
                Identifier = identifier,
                Type = "Backpack"
            })
        end
    end
    
    if LocalPlayer.Character then
        for _, tool in pairs(LocalPlayer.Character:GetChildren()) do
            if tool:IsA("Tool") then
                local identifier = tool:GetAttribute("ID") or tool.Name
                table.insert(tools, {
                    Name = tool.Name,
                    Tool = tool,
                    Identifier = identifier,
                    Type = "Equipped"
                })
            end
        end
    end
    
    return tools
end

