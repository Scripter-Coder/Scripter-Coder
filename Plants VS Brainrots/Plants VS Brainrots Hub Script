-- Function to check if tool is a valid seed (DEFINED FIRST)
local function isValidSeedTool(tool)
    if not tool:IsA("Tool") then return false end
    
    -- SPECIFIC EXCLUSION: Cannonocci
    if string.lower(tool.Name) == "cannonocci" then
        return false
    end
    
    local toolName = string.lower(tool.Name)
    local hasSeedAttribute = tool:GetAttribute("Seed")
    
    -- Must contain "seed" in name (case-insensitive) OR have Seed attribute
    return string.find(toolName, "seed") ~= nil or hasSeedAttribute ~= nil
end

-- STRICT seed tool filter - excludes "Cannonocci" specifically
_G.updateTools = function()
    _G.allTools = {}
    local toolNames = {}
    
    -- Check backpack
    for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
        if isValidSeedTool(tool) and not toolNames[tool.Name] then
            toolNames[tool.Name] = true
            table.insert(_G.allTools, {
                Name = tool.Name,
                Tool = tool,
                SeedAttribute = tool:GetAttribute("Seed"),
                ID = tool:GetAttribute("ID"),
                Type = "Backpack",
                IsSeed = true
            })
        end
    end
    
    -- Check character
    if LocalPlayer.Character then
        for _, tool in pairs(LocalPlayer.Character:GetChildren()) do
            if isValidSeedTool(tool) and not toolNames[tool.Name] then
                toolNames[tool.Name] = true
                table.insert(_G.allTools, {
                    Name = tool.Name,
                    Tool = tool,
                    SeedAttribute = tool:GetAttribute("Seed"),
                    ID = tool:GetAttribute("ID"),
                    Type = "Equipped",
                    IsSeed = true
                })
            end
        end
    end
    
    return _G.allTools
end

-- Find plot
_G.findMyPlot = function()
    local myDisplayName = LocalPlayer.DisplayName
    
    for _, plotFolder in pairs(workspace.Plots:GetChildren()) do
        local playerSign = plotFolder:FindFirstChild("PlayerSign")
        if playerSign and playerSign:IsA("BasePart") then
            local billboardGui = playerSign:FindFirstChildWhichIsA("BillboardGui")
            if billboardGui then
                local textLabel = billboardGui:FindFirstChild("TextLabel")
                if textLabel and textLabel:IsA("TextLabel") then
                    if string.find(textLabel.Text, myDisplayName) then
                        _G.myPlot = plotFolder
                        return _G.myPlot
                    end
                end
            end
        end
    end
    
    _G.myPlot = nil
    return nil
end

-- Get grass parts
local function getGrassParts()
    if not _G.myPlot then return {} end
    
    local grassParts = {}
    local rowsFolder = _G.myPlot:FindFirstChild("Rows")
    
    if not rowsFolder then return grassParts end
    
    for _, rowFolder in pairs(rowsFolder:GetChildren()) do
        if rowFolder:IsA("Folder") then
            local grassFolder = rowFolder:FindFirstChild("Grass")
            if grassFolder then
                for _, grassPart in pairs(grassFolder:GetChildren()) do
                    if grassPart:IsA("BasePart") then
                        table.insert(grassParts, {
                            Part = grassPart,
                            Position = grassPart.Position
                        })
                    end
                end
            end
        end
    end
    
    return grassParts
end

-- Equip seed tool
local function equipSeedTool(toolData)
    if not LocalPlayer.Character then return false end
    
    local humanoid = LocalPlayer.Character:FindFirstChild("Humanoid")
    if not humanoid then return false end
    
    if toolData.Type == "Equipped" then
        return true
    end
    
    if not toolData.Tool or not toolData.Tool.Parent then
        return false
    end
    
    humanoid:EquipTool(toolData.Tool)
    
    for i = 1, 10 do
        if toolData.Tool.Parent == LocalPlayer.Character then
            return true
        end
        task.wait(0.05)
    end
    
    return false
end

-- Plant function
local function plantSeed(toolData)
    if not toolData.IsSeed then
        return false
    end
    
    if not _G.myPlot and not _G.findMyPlot() then
        return false
    end
    
    local grassParts = getGrassParts()
    if #grassParts == 0 then
        return false
    end
    
    -- Select grass part
    local targetGrass
    if _G.selectedMode == "Player Position" and LocalPlayer.Character then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local playerPos = hrp.Position
            local closestDist = math.huge
            
            for _, grass in pairs(grassParts) do
                local dist = (playerPos - grass.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    targetGrass = grass
                end
            end
        end
    end
    
    if not targetGrass then
        targetGrass = grassParts[math.random(1, #grassParts)]
    end
    
    -- Equip tool
    if not equipSeedTool(toolData) then
        return false
    end
    
    task.wait(0.1)
    
    -- Plant
    local seedName = toolData.SeedAttribute or toolData.Name
    local plantID = toolData.ID or HttpService:GenerateGUID(false)
    
    -- Equip item
    if EquipItemRemote.ClassName == "BindableEvent" then
        EquipItemRemote:Fire(seedName, plantID)
    else
        EquipItemRemote:FireServer(seedName, plantID)
    end
    
    task.wait(0.1)
    
    -- Place item
    local args = {
        {
            ID = plantID,
            CFrame = CFrame.new(targetGrass.Position.X, targetGrass.Position.Y + 1, targetGrass.Position.Z),
            Item = seedName,
            Floor = targetGrass.Part
        }
    }
    
    if PlaceItemRemote.ClassName == "RemoteEvent" then
        PlaceItemRemote:FireServer(unpack(args))
    else
        PlaceItemRemote:Fire(unpack(args))
    end
    
    task.wait(0.05)
    
    -- Unequip
    if EquipItemRemote.ClassName == "BindableEvent" then
        EquipItemRemote:Fire()
    else
        EquipItemRemote:FireServer()
    end
    
    return true
end

