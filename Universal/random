-- Optimized spawn protection
local function protectSpawn()
    if not spawnProtectionEnabled or not spawnPart then return end
    
    -- Check if spawn is at default position
    local defaultPos = Vector3.new(0, 48.5, 0)
    local currentPos = spawnPart.Position
    local tolerance = 1.0
    
    local isDefaultPosition = math.abs(currentPos.X - defaultPos.X) < tolerance and
                              math.abs(currentPos.Y - defaultPos.Y) < tolerance and
                              math.abs(currentPos.Z - defaultPos.Z) < tolerance
    
    if isDefaultPosition then
        spawnprotection:ClearAllChildren()
        return
    end
    
    -- Only create protection if it doesn't exist
    if #spawnprotection:GetChildren() == 0 then
        local spawnPos = spawnPart.Position
        local protectionSize = Vector3.new(25, 25, 25)
        
        local part = Instance.new("Part")
        part.Size = protectionSize
        part.Position = spawnPos + Vector3.new(0, 12.5, 0)
        part.Anchored = true
        part.CanCollide = true
        part.CanTouch = false
        part.Transparency = 0.5
        part.BrickColor = BrickColor.new("Bright blue")
        part.Material = Enum.Material.Neon
        part.Parent = spawnprotection
        
        if notifOn then
            notif("Spawn protected!", "Spawn Protection")
        end
    end
end

