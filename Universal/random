-- Optimized bullet detection
local function isBulletNear(root, dangerDistance)
    dangerDistance = dangerDistance or 40
    local rootPos = root.Position
    
    for _, bullet in ipairs(bullets:GetChildren()) do
        if bullet and bullet:IsA("BasePart") and bullet.Transparency ~= 1 then
            local dist = (rootPos - bullet.Position).Magnitude
            if dist < dangerDistance then
                return true, bullet, dist
            end
        end
    end
    return false, nil, nil
end

-- Optimized escape from bullet
local function escapeFromBullet(root, hitbox, bullet)
    if not root or not bullet then return end
    
    local pushDir = (root.Position - bullet.Position).Unit
    if pushDir.Magnitude > 0 then
        local escapePos = root.Position + pushDir * 40 + Vector3.new(0, 12, 0)
        root.Position = escapePos
        if hitbox then
            hitbox.Position = escapePos
        end
    end
end

-- Optimized gift collection
local function getAllValidGifts()
    local validGifts = {}
    
    -- Check all gift types in one loop
    local allGiftParents = {gifts, goldengifts}
    if passagegifts then table.insert(allGiftParents, passagegifts) end
    
    for _, parent in ipairs(allGiftParents) do
        if parent then
            for _, gift in ipairs(parent:GetChildren()) do
                if gift and gift:IsA("BasePart") and gift.Transparency == 0 and gift:FindFirstChild("Collect", true) then
                    if not isInvalidGift(gift) then
                        table.insert(validGifts, gift)
                    end
                end
            end
        end
    end
    
    return validGifts
end

