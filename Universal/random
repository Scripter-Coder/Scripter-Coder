-- Guardian bullet protection (optimized)
local bulletProtectionCache = {}

local function protectBullet(b)
    if not b or b.Transparency == 1 then return end
    
    if not b:GetAttribute("uuid") then
        b:SetAttribute("uuid", HttpService:GenerateGUID(false))
    end

    local id = b:GetAttribute("uuid")

    if bulletProtectionCache[id] then return end

    local sizeoffset = b.Size.X + 5

    local p = Instance.new("Part")
    p.Name = id
    p.Shape = Enum.PartType.Ball
    p.Size = Vector3.new(sizeoffset, sizeoffset, sizeoffset)
    p.Position = b.Position
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.Transparency = 0.35
    p.Parent = bulletprots
    
    bulletProtectionCache[id] = p

    b:GetPropertyChangedSignal("Transparency"):Once(function()
        bulletProtectionCache[id] = nil
        p:Destroy()
    end)
end

local function isdirectionsafetopushfromguardianbullet(pos, direction)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    rayParams.FilterDescendantsInstances = {plr.Character}

    local result = workspace:Raycast(pos, direction * 6, rayParams)
    return result ~= nil and result.Instance and result.Instance.CanCollide == true
end

-- Optimized render step for protections
RunService:BindToRenderStep("GuardianProtection", Enum.RenderPriority.Last.Value + 1, function()
    if isDead(plr) then return end

    local char = getChar(plr)
    local root = getRoot(char)
    if not char or not root then return end

    if pb and root then
        -- Get bullets once
        local bulletList = bullets:GetChildren()
        local rootPos = root.Position
        
        for _, b in ipairs(bulletList) do
            if b.Transparency ~= 1 then
                protectBullet(b)

                local uuid = b:GetAttribute("uuid")
                if uuid then
                    local p = bulletProtectionCache[uuid]
                    if p then
                        p.Position = b.Position
                    end
                end
            end
        end

        for _, p in ipairs(bulletProtectionCache) do
            if p then
                local offset = rootPos - p.Position
                local dist = offset.Magnitude
                local radius = p.Size.X / 2
                local pushDir = offset.Unit

                if dist < radius and isdirectionsafetopushfromguardianbullet(rootPos, pushDir) then
                    root.CFrame += pushDir * 3
                elseif dist < radius then
                    local altDir = Vector3.new(-pushDir.Z, 0, pushDir.X)

                    if isdirectionsafetopushfromguardianbullet(rootPos, altDir) then
                        root.CFrame += altDir * 3
                    else
                        root.Position = p.Position + Vector3.new(0, 10, 0)
                    end
                end
            end
        end
    end
end)

