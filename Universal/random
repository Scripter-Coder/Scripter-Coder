-- Simplified disableEnemy with less overhead
local function disableEnemy(enemyName, willDestroy, willBreakAI, failNotif)
    if failNotif == nil then failNotif = true end
    if willBreakAI == nil then willBreakAI = false end

    local function destroyEnemy(name)
        local count = 0
        for _, enemy in ipairs(enemies:GetChildren()) do
            if enemy.Name == name then
                enemy:Destroy()
                count = count + 1
            end
        end
        if notifOn then
            notif(name.." disabled. (destroyed)", "Enemy")
        end
        return count > 0
    end

    -- Special case for Skinwalker
    if enemyName == "Skinwalker" then
        local skinwalkers = workspace.Skinwalkers
        local count = 0
        for _, sw in ipairs(skinwalkers:GetChildren()) do
            sw:Destroy()
            count = count + 1
        end
        if count > 0 then
            notif("Destroyed " .. count .. " Husk(s)", "Enemy")
            return true
        end
        return false
    end

    if willDestroy then
        return destroyEnemy(enemyName)
    end

    local count = 0
    local total = 0
    
    for _, enemy in ipairs(enemies:GetChildren()) do
        if enemy.Name == enemyName then
            total = total + 1
            local disabled = false
            
            -- Try to find and destroy touch interests
            for _, part in ipairs(enemy:GetDescendants()) do
                if part.Name == "TouchInterest" or part.Name == "Kill" then
                    part:Destroy()
                    disabled = true
                end
            end
            
            if disabled then
                enemy:SetAttribute("Disabled", true)
                count = count + 1
            end
        end
    end

    if total > 0 and count >= total then
        if notifOn then
            notif(tostring(count).." "..enemyName.."(s) disabled.", "Enemy")
        end
        return true
    else
        if failNotif and notifOn then
            notif(enemyName.." cannot be fully disabled yet.", "Enemy")
        end
        return false
    end
end

