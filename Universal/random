                                    if distToBeacon < 30 then
                                        isNearBeacon = true
                                        break
                                    end
                                end
                            end
                        end
                        
                        if distToSpawn > SAFE_DISTANCE and not isNearBeacon then
                            table.insert(filteredGifts, gift)
                        end
                    end
                    
                    -- Fallback if no filtered gifts
                    if #filteredGifts == 0 then
                        for _, gift in ipairs(validGifts) do
                            local distToSpawn = (gift.Position - spawnPos).Magnitude
                            if distToSpawn > 30 then
                                table.insert(filteredGifts, gift)
                            end
                        end
                    end
                    
                    -- If STILL no gifts, use all but warn
                    if #filteredGifts == 0 then
                        filteredGifts = validGifts
                        if notifOn then
                            notif("⚠️ No safe gifts found! Using all gifts", "Warning")
                        end
                    end
                    
                    if #filteredGifts > 0 then
                        noGiftTimer = 0
                        local randomGift = filteredGifts[math.random(1, #filteredGifts)]
                        
                        -- Teleport to gift position with height offset
                        local heightOffset = math.random(5, 10)
                        local pos = randomGift.Position + Vector3.new(0, heightOffset, 0)
                        
                        -- Perform teleport
                        root.Position = pos
                        if hitbox then
                            hitbox.Position = pos
                        end
                        
                        -- 🔥 UPDATE LAST TELEPORT TIME (start cooldown)
                        lastTeleportTime = currentTime
                        
                        collectedCount = collectedCount + 1
                        updateCollectionLabel()
                        
                        -- 🔥 WAIT THE FULL 0.4 SECONDS
                        task.wait(TELEPORT_COOLDOWN)
                    else
                        noGiftTimer = noGiftTimer + 0.1
                        if noGiftTimer >= 1.0 and spawnPart then
                            root.Position = spawnPart.Position + Vector3.new(0, 5, 0)
                            if hitbox then
                                hitbox.Position = root.Position
                            end
                            noGiftTimer = 0
                            task.wait(0.3)
                        end
                        task.wait(0.1)
                    end
                end
            end)
        else
            autoCollectRunning = false
        end
    end
})

