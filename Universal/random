local function protectTripmine(trip)
    if not trip or trip.Transparency == 1 then return end
    
    if not trip:GetAttribute("uuid") then
        trip:SetAttribute("uuid", HttpService:GenerateGUID(false))
    end

    local id = trip:GetAttribute("uuid")

    if tripmineProtectionCache[id] then return end

    local startPos = trip.Position

    local p = Instance.new("Part")
    p.Name = id
    p.Shape = Enum.PartType.Ball
    p.Size = Vector3.new(15, 15, 15)
    p.Position = startPos
    p.Anchored = true
    p.CanCollide = true
    p.Transparency = 0.5
    p.BrickColor = BrickColor.new("Bright red")
    p.Material = Enum.Material.Neon
    p.Parent = tripmineprots
    
    tripmineProtectionCache[id] = p

    trip:GetPropertyChangedSignal("Transparency"):Once(function()
        tripmineProtectionCache[id] = nil
        p:Destroy()
    end)
end

