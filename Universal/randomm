-- Helper function to get slap requirement text for any glove (case insensitive)
local function getSlapRequirement(gloveName)
	-- Try multiple possible folder names (case variations)
	local possibleNames = {
		gloveName,
		gloveName:lower(),
		gloveName:upper(),
		gloveName:sub(1,1):upper() .. gloveName:sub(2):lower(), -- Capitalized
		string.gsub(gloveName, " ", "") -- Remove spaces
	}
	
	for _, name in ipairs(possibleNames) do
		local success, slapText = pcall(function()
			local gloveStand = workspace.Lobby.GloveStands:FindFirstChild(name)
			if gloveStand then
				local slapPart = gloveStand:FindFirstChild("SlapsInfoPart")
				if slapPart then
					local surfaceGui = slapPart:FindFirstChild("SurfaceGui")
					if surfaceGui then
						local textLabel = surfaceGui:FindFirstChild("TextLabel")
						if textLabel then
							return textLabel.Text
						end
					end
				end
			end
		end)
		if success and slapText and slapText ~= "" then
			return slapText
		end
	end
	
	-- Special case for Woah (different folder name)
	local woahSuccess, woahSlapText = pcall(function()
		local woahStand = workspace.Lobby.GloveStands:FindFirstChild("woah")
		if woahStand then
			local slapPart = woahStand:FindFirstChild("SlapsInfoPart")
			if slapPart then
				local surfaceGui = slapPart:FindFirstChild("SurfaceGui")
				if surfaceGui then
					local textLabel = surfaceGui:FindFirstChild("TextLabel")
					if textLabel then
						return textLabel.Text
					end
				end
			end
		end
	end)
	if woahSuccess and woahSlapText and woahSlapText ~= "" then
		return woahSlapText
	end
	
	return "???"
end

