-- Function to play animation
local function PlayAnimation(animName)
    local character = LocalPlayer.Character
    if not character then
        WindUI:Notify({
            Title = "Error",
            Content = "Character not found!",
            Icon = "rbxassetid://7743878857",
            Duration = 2
        })
        return
    end
    
    local humanoid = character:FindFirstChildWhichIsA("Humanoid")
    if not humanoid then
        WindUI:Notify({
            Title = "Error",
            Content = "Humanoid not found!",
            Icon = "rbxassetid://7743878857",
            Duration = 2
        })
        return
    end
    
    -- Stop current animation
    if currentTrack then
        pcall(function() currentTrack:Stop() end)
        currentTrack = nil
    end
    
    if currentAnim then
        pcall(function() currentAnim:Destroy() end)
        currentAnim = nil
    end
    
    -- Get animation ID
    local animId = Animations[animName]
    if not animId then
        WindUI:Notify({
            Title = "Error",
            Content = "Animation not found!",
            Icon = "rbxassetid://7743878857",
            Duration = 2
        })
        return
    end
    
    -- Create and play animation
    local anim = Instance.new("Animation")
    anim.AnimationId = animId
    currentAnim = anim
    
    local success, track = pcall(function()
        return humanoid:LoadAnimation(anim)
    end)
    
    if success and track then
        currentTrack = track
        track.Priority = Enum.AnimationPriority.Action
        track:Play()
        
        WindUI:Notify({
            Title = "Playing Animation",
            Content = "Now playing: " .. animName,
            Icon = "rbxassetid://4483345998",
            Duration = 2
        })
        
        print("✅ Playing: " .. animName)
        print("   ID: " .. animId)
    else
        WindUI:Notify({
            Title = "Error",
            Content = "Failed to load animation!",
            Icon = "rbxassetid://7743878857",
            Duration = 2
        })
    end
end

-- Stop animation function
local function StopAnimation()
    if currentTrack then
        pcall(function() currentTrack:Stop() end)
        currentTrack = nil
    end
    if currentAnim then
        pcall(function() currentAnim:Destroy() end)
        currentAnim = nil
    end
    
    WindUI:Notify({
        Title = "Animation Stopped",
        Content = "Animation has been stopped.",
        Icon = "rbxassetid://4483345998",
        Duration = 2
    })
    
    print("⏹️ Animation stopped")
end

