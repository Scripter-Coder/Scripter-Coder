                local slapsValue = player.leaderstats and player.leaderstats:FindFirstChild("Slaps") and player.leaderstats.Slaps.Value or 0
                local nullShards = 0
                local playerData = replicatedStorage:FindFirstChild("PlayerData")
                if playerData then
                    local playerFolder = playerData:FindFirstChild(player.Name)
                    if playerFolder then
                        local nullShardsValue = playerFolder:FindFirstChild("NullShards")
                        if nullShardsValue then
                            nullShards = nullShardsValue.Value or 0
                        end
                    end
                end
                local health = humanoid.Health
                local maxHealth = humanoid.MaxHealth
                local textColor = Color3.fromRGB(255, 255, 255)
                local highlightColor = Color3.fromRGB(255, 255, 255)
                if ESPsettings.ShowGhost and gloveValue == "Ghost" then
                    textColor = Color3.fromRGB(255, 0, 0)
                    highlightColor = Color3.fromRGB(255, 0, 0)
                elseif ESPsettings.ShowReaper and gloveValue == "Reaper" then
                    textColor = Color3.fromRGB(0, 0, 0)
                    highlightColor = Color3.fromRGB(0, 0, 0)
                elseif ESPsettings.ShowReverse and gloveValue == "Reverse" then
                    textColor = Color3.fromRGB(255, 255, 0)
                    highlightColor = Color3.fromRGB(255, 255, 0)
                elseif ESPsettings.ShowKillstreak and gloveValue == "Killstreak" then
                    local kills = character:FindFirstChild("CleanKillStreak") and character.CleanKillStreak.Value or 0
                    textColor = getKillstreakColor(kills)
                    highlightColor = getKillstreakColor(kills)
                end
                updateHighlight(character, highlightColor)
                if not head:FindFirstChild("PlayerEsp") then
                    createPlayerBillboard(head, player.Name, textColor,
                        ESPsettings.ShowGlove and gloveValue or nil,
                        ESPsettings.ShowSlaps and slapsValue or nil,
                        ESPsettings.ShowNullShards and nullShards or nil,
                        ESPsettings.ShowHealth and health or nil,
                        ESPsettings.ShowHealth and maxHealth or nil
                    )
                else
                    local billboard = head.PlayerEsp
                    local frame = billboard:FindFirstChildOfClass("Frame")
                    if frame then
                        local labels = {}
                        for _, child in ipairs(frame:GetChildren()) do
                            if child:IsA("TextLabel") then
                                table.insert(labels, child)
                            end
                        end
                        -- Update labels based on order
                        for i, label in ipairs(labels) do
                            if i == 1 then
                                label.Text = player.Name
                                label.TextColor3 = textColor
                            elseif i == 2 and ESPsettings.ShowGlove then
                                label.Text = "Glove: " .. gloveValue
                                label.TextColor3 = getGloveColor(gloveValue)
                            elseif i == 3 and ESPsettings.ShowSlaps then
                                label.Text = "Slaps: " .. tostring(slapsValue)
                            elseif i == 4 and ESPsettings.ShowHealth then
                                label.Text = "Health: " .. math.floor(health) .. "/" .. tostring(maxHealth)
                                label.TextColor3 = health <= 20 and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(100, 255, 100)
                            elseif i == 5 and ESPsettings.ShowNullShards then
                                label.Text = "Null Shards: " .. tostring(nullShards)
                            end
                        end
                    end
                end
            else
                removeHighlight(character)
            end
        end
    end
end

