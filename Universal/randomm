-- Function to get random normal player
local function getRandomPlayer()
	local players = {}
	for _, player in pairs(game.Players:GetPlayers()) do
		if player ~= game.Players.LocalPlayer then
			table.insert(players, player)
		end
	end
	if #players > 0 then
		return players[math.random(1, #players)]
	end
	return nil
end

-- Function to get random staff player (rank >= 2 in group)
local function getRandomStaffPlayer()
	local groupId = 9950771 -- Replace with your group ID
	local staffPlayers = {}
	for _, player in pairs(game.Players:GetPlayers()) do
		if player ~= game.Players.LocalPlayer then
			local rank = pcall(function() return player:GetRankInGroup(groupId) end)
			if rank and rank >= 2 then
				table.insert(staffPlayers, player)
			end
		end
	end
	if #staffPlayers > 0 then
		return staffPlayers[math.random(1, #staffPlayers)]
	end
	return nil
end

