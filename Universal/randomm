            })
            workspace.CurrentCamera.CameraSubject = originalSubject
            workspace.CurrentCamera.CFrame = originalCF
            return
        end
        
        -- Reset first (hit the reset button if it exists)
        local resetButton = buttons:FindFirstChild("Reset")
        if resetButton then
            local clickDetector = resetButton:FindFirstChild("ClickDetector")
            if clickDetector then
                fireclickdetector(clickDetector)
                task.wait(0.3)
            end
        end
        
        -- Type the code
        local codeStr = tostring(code)
        for i = 1, #codeStr do
            local digit = string.sub(codeStr, i, i)
            local button = buttons:FindFirstChild(digit)
