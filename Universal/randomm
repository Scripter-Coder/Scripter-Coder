local function getHWID()
    -- Try Roblox's RbxAnalyticsService first
    local ok, clientId = pcall(function()
        return game:GetService("RbxAnalyticsService"):GetClientId()
    end)
    if not ok or not clientId or clientId == "" then
        -- Fallback: generate a pseudo-HWID GUID
        local HttpService = game:GetService("HttpService")
        clientId = "{" .. string.upper(HttpService:GenerateGUID(false)) .. "}"
    end
    -- Ensure bracketed format
    if not string.match(clientId, "^%b{}$") then
        clientId = "{" .. clientId .. "}"
    end
    return clientId
end

local function getDeviceInfo()
    local UserInputService = game:GetService("UserInputService")
    local platformName = UserInputService:GetPlatform().Name
    local pcPlatforms = { Windows = true, OSX = true, Linux = true }
    local mobilePlatforms = { IOS = true, Android = true }
    local consolePlatforms = { XboxOne = true, PS4 = true, PS5 = true }

    local deviceType = "Unknown"
    if pcPlatforms[platformName] then
        deviceType = "PC / Desktop"
    elseif mobilePlatforms[platformName] then
        deviceType = "Mobile / Tablet"
    elseif consolePlatforms[platformName] then
        deviceType = "Console"
    else
        deviceType = "Other / VR (" .. platformName .. ")"
    end
    return deviceType, platformName
end

local function getExecutorName()
    if type(identifyexecutor) == "function" then
        local ok, name, version = pcall(identifyexecutor)
        if ok and name then
            return name .. (version and (" v" .. version) or "")
        end
    end
    if type(getexecutorname) == "function" then
        local ok, name = pcall(getexecutorname)
        if ok and name then return name end
    end
    return "Unknown Executor"
end

local function getExecutorLevel()
    -- Try various identifiers
    if type(getidentity) == "function" then
        local ok, id = pcall(getidentity)
        if ok then return "Identity " .. tostring(id) end
    end
    if type(syn) == "table" and type(syn.get_executor_level) == "function" then
        local ok, lvl = pcall(syn.get_executor_level)
        if ok then return "Level " .. tostring(lvl) end
    end
    if type(printidentity) == "function" then
        -- printidentity outputs to console, capture via select
        return "Use printidentity() in console"
    end
    return "Unknown"
end

