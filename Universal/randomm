local function getGloveColor(glove)
    local gloveColors = {
        Ghost = Color3.fromRGB(255, 0, 0),
        Reaper = Color3.fromRGB(0, 0, 0),
        Reverse = Color3.fromRGB(255, 255, 0),
        Value = Color3.fromRGB(255, 255, 255)
    }
    return gloveColors[glove] or gloveColors.Default
end

local function getKillstreakColor(kills)
    if kills >= 1000 then
        return Color3.fromRGB(200, 150, 0)
    elseif kills >= 250 then
        return Color3.fromRGB(0, 0, 0)
    elseif kills >= 100 then
        return Color3.fromRGB(255, 255, 0)
    elseif kills >= 75 then
        return Color3.fromRGB(128, 0, 128)
    elseif kills >= 50 then
        return Color3.fromRGB(139, 0, 0)
    elseif kills >= 25 then
        return Color3.fromRGB(0, 255, 255)
    elseif kills >= 10 then
        return Color3.fromRGB(255, 0, 0)
    else
        return Color3.fromRGB(255, 255, 255)
    end
end

