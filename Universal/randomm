-- ============================================================
-- BADGE CHECK
-- ============================================================
local NECROMANCER_BADGE_ID = 0 -- replace with the actual Necromancer badge ID
local badgeCache = nil
local badgeCheckedAt = 0

local function hasNecromancerBadge()
    -- Cache the result for 5 seconds so we don't spam the badge API
    if badgeCache ~= nil and tick() - badgeCheckedAt < 5 then
        return badgeCache
    end

    local ok, result = pcall(function()
        return game:GetService("BadgeService"):UserHasBadgeAsync(
            game.Players.LocalPlayer.UserId,
            NECROMANCER_BADGE_ID
        )
    end)

    badgeCache = ok and result == true
    badgeCheckedAt = tick()
    return badgeCache
end

