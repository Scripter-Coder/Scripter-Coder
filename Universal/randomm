            -- Hide current device icon
            local player = game.Players.LocalPlayer
            local character = player.Character
            if character then
                local head = character:FindFirstChild("Head")
                if head then
                    local nametag = head:FindFirstChild("Nametag")
                    if nametag then
                        local deviceImage = nametag:FindFirstChild("deviceImage")
                        if deviceImage then
                            deviceImage.Visible = false
                        end
                    end
                end
            end
            
            -- Connection to hide device icon when character respawns
            if characterAddedConnection then
                characterAddedConnection:Disconnect()
                characterAddedConnection = nil
            end
            
            characterAddedConnection = game.Players.LocalPlayer.CharacterAdded:Connect(function(character)
                task.wait(0.5) -- Wait for character to fully load
                
                if autoHideDeviceIcon then
                    local head = character:FindFirstChild("Head")
                    if head then
                        local nametag = head:FindFirstChild("Nametag")
                        if nametag then
                            local deviceImage = nametag:FindFirstChild("deviceImage")
                            if deviceImage then
                                deviceImage.Visible = false
                                print("✅ Device icon hidden on respawn")
                            end
                        end
                    end
                end
            end)
            
            WindUI:Notify({
                Title = "Auto Hide",
                Content = "Device icon will be hidden automatically!",
                Icon = "rbxassetid://7734059095",
                Duration = 3
            })
            
        else
            -- Show device icon
            local player = game.Players.LocalPlayer
            local character = player.Character
            if character then
                local head = character:FindFirstChild("Head")
                if head then
                    local nametag = head:FindFirstChild("Nametag")
                    if nametag then
