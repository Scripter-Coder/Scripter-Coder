function savePreferences()
    local data = {
        Toggles = Preferences.Toggles,
        Sliders = Preferences.Sliders,
        Dropdowns = Preferences.Dropdowns,
        Inputs = Preferences.Inputs,
        Theme = Preferences.Theme,
