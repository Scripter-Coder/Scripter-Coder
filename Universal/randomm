-- Function to get ingredients for a potion
local function getPotionIngredients(potionName)
    local recipe = PotionRecipes[potionName]
    if recipe then
        return recipe.ingredients, recipe.amounts
    end
    return nil, nil
end

-- Function to fire AlchemistEvent
local function fireAlchemistEvent(action, item)
    local args = {action}
    if item then
        table.insert(args, item)
    end
    game:GetService("ReplicatedStorage"):WaitForChild("AlchemistEvent"):FireServer(unpack(args))
end

-- Function to craft a single potion
local function craftPotion(potionName)
    local ingredients, amounts = getPotionIngredients(potionName)
    if not ingredients then
        return false
    end
    
    -- Step 1: Spawn Cauldron
    game:GetService("ReplicatedStorage"):WaitForChild("GeneralAbility"):FireServer()
    task.wait()
    
    -- Step 2: Collect and Mix each ingredient
    for i, ingredient in ipairs(ingredients) do
        local amount = amounts[i] or 1
        
        for j = 1, amount do
            -- Collect ingredient
            fireAlchemistEvent("AddItem", ingredient)
            task.wait(craftSpeed)
            
            -- Equip ingredient
            fireAlchemistEvent("EquipItem", ingredient)
            task.wait(craftSpeed)
            
            -- Mix ingredient
            fireAlchemistEvent("MixItem", ingredient)
            task.wait(craftSpeed)
        end
    end
    
    -- Step 3: Brew the potion
    fireAlchemistEvent("BrewPotion")
    task.wait()
    
    return true
end

