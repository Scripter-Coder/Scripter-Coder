    -- Create toggle (FIXED: proper cooldown handling)
    Tab:Toggle({
        Title = "Slap Aura",
        Value = false,
        Callback = function(enabled)
            isSlapAuraEnabled = enabled
            
            if enabled then
                -- Disconnect existing connection
                if slapAuraConnection then
                    slapAuraConnection:Disconnect()
                    slapAuraConnection = nil
                end
                
                -- Get current glove and remote
                local currentGlove = getCurrentGlove()
                local remote = getGloveRemote(currentGlove)
                
                if not remote or remote == "" then
                    WindUI:Notify({
                        Title = "Slap Aura Error",
                        Content = "No remote found for glove: " .. currentGlove,
                        Icon = "rbxassetid://7733919105",
                        Duration = 3
                    })
                    isSlapAuraEnabled = false
                    return
                end
                
                print("Slap Aura: Enabled with glove '" .. currentGlove .. "' using remote '" .. remote.Name .. "'")
                
                -- Reset last hit time
                lastHitTime = 0
                
                -- Create connection with proper cooldown
                slapAuraConnection = RunService.Heartbeat:Connect(function()
                    if not isSlapAuraEnabled then
                        return
                    end
                    
                    local currentTime = tick()
                    if currentTime - lastHitTime < currentCooldown then
                        return
                    end
                    
                    local character = localPlayer.Character
                    if not character then
                        return
                    end
                    
                    -- Get all targets
                    local targets = getAllTargets()
                    
                    -- Hit each target (only ONE hit per cooldown cycle)
                    for _, target in ipairs(targets) do
                        if target and target.Parent and target:IsA("BasePart") then
                            local success = pcall(function()
                                remote:FireServer(target)
                            end)
                            if success then
                                -- Update last hit time after hitting ALL targets
                                -- This prevents multiple hits per cooldown cycle
                            end
                        end
                    end
                    
                    -- Update last hit time after processing all targets
                    lastHitTime = currentTime
                end)
                
                WindUI:Notify({
                    Title = "Slap Aura Enabled",
                    Content = "Glove: " .. currentGlove,
                    Icon = "rbxassetid://7733919105",
                    Duration = 3
                })
                
            else
                if slapAuraConnection then
                    slapAuraConnection:Disconnect()
                    slapAuraConnection = nil
                end
                
            end
        end
    })
