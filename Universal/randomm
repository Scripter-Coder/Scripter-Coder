    local ConfigName = "default"

    -- Read a config file's __autoload flag straight from disk
    local function ReadAutoLoadFlag(name)
        if isfile and readfile then
            local path = ConfigManager.Path .. name .. ".json"
            if isfile(path) then
                local ok, data = pcall(function()
                    return game:GetService("HttpService"):JSONDecode(readfile(path))
                end)
                if ok and data and data.__autoload ~= nil then
                    return data.__autoload
                end
            end
        end
        return false
    end

    local ConfigNameInput = Tab:Input({
        Title = "Config Name",
        Desc = "Name a new config or pick an existing one",
        Icon = "file-cog",
        Value = ConfigName,
        Callback = function(value)
            ConfigName = value
        end
    })

    local AllConfigsDropdown
    local AutoLoadToggle
    local autoLoadUpdating = false

    local function SetAutoLoadDisplay(state)
        if not AutoLoadToggle then return end
        autoLoadUpdating = true
        AutoLoadToggle:Set(state)
        autoLoadUpdating = false
    end

    AllConfigsDropdown = Tab:Dropdown({
        Title = "All Configs",
        Desc = "Saved configs on your device",
        Icon = "folder-open",
        Values = ConfigManager:AllConfigs(),
        Value = table.find(ConfigManager:AllConfigs(), ConfigName) and ConfigName or nil,
        Callback = function(value)
            ConfigName = value
            ConfigNameInput:Set(value)
            SetAutoLoadDisplay(ReadAutoLoadFlag(value))
        end
    })

    Tab:Button({
        Title = "Save Config",
        Desc = "Creates or overwrites the config with the current toggle states",
        Icon = "save",
        Callback = function()
            if ConfigName == "" or ConfigName == nil then
                WindUI:Notify({
                    Title = "Config",
                    Content = "Enter a config name first!",
                    Duration = 3
                })
                return
            end

            Window.CurrentConfig = ConfigManager:Config(ConfigName)
            if Window.CurrentConfig:Save() then
                WindUI:Notify({
                    Title = "Config Saved",
                    Content = "'" .. ConfigName .. "' saved",
                    Icon = "check",
                    Duration = 3
                })
            end

            AllConfigsDropdown:Refresh(ConfigManager:AllConfigs())
        end
    })

    Tab:Button({
        Title = "Load Config",
        Desc = "Applies the saved toggle states from the selected config",
        Icon = "folder-open",
        Callback = function()
            if ConfigName == "" or ConfigName == nil then
                WindUI:Notify({
                    Title = "Config",
                    Content = "Enter a config name first!",
                    Duration = 3
                })
                return
            end

            Window.CurrentConfig = ConfigManager:CreateConfig(ConfigName)
            local ok = Window.CurrentConfig:Load()
            if ok then
                WindUI:Notify({
                    Title = "Config Loaded",
                    Content = "'" .. ConfigName .. "' loaded",
                    Icon = "check",
                    Duration = 3
                })
            else
                WindUI:Notify({
                    Title = "Config",
                    Content = "Config file does not exist!",
                    Duration = 3
                })
            end

            AllConfigsDropdown:Refresh(ConfigManager:AllConfigs())
        end
    })

    Tab:Button({
        Title = "Delete Config",
        Desc = "Permanently removes the selected config file",
        Icon = "trash",
        Callback = function()
            if ConfigName == "" or ConfigName == nil then
                WindUI:Notify({
                    Title = "Config",
                    Content = "Enter a config name first!",
                    Duration = 3
                })
                return
            end

            local success, msg = ConfigManager:DeleteConfig(ConfigName)
            if success then
                WindUI:Notify({
                    Title = "Config Deleted",
                    Content = "'" .. ConfigName .. "' deleted",
                    Icon = "check",
                    Duration = 3
                })
            else
                WindUI:Notify({
                    Title = "Config",
                    Content = tostring(msg),
                    Duration = 3
                })
            end

            AllConfigsDropdown:Refresh(ConfigManager:AllConfigs())
        end
    })

Section = Tab:Section({
    Title = "Destroy Script"
})
Tab:Button({
    Title = "Destroy Gui",
    Callback = function()
        Window:Destroy()
    end
})
end
else
WindUI:Notify({Title = "Error",Content = "Place is not supported",Icon = "rbxassetid://7734053361",Duration = 10})
end

