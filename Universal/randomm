                    v:Destroy()
                end
            end
            return
        end
        task.spawn(function()
            while _G.ShowBadgesESP do
                local replicatedStorage = game:GetService("ReplicatedStorage")
                local playerData = replicatedStorage:FindFirstChild("PlayerData")
                if playerData then
                    for _, playerFolder in pairs(playerData:GetChildren()) do
                        if playerFolder:IsA("Folder") then
                            local unlockedBadges = playerFolder:FindFirstChild("UnlockedBadges")
                            if unlockedBadges then
                                local badgeIds = {}
                                pcall(function()
                                    if type(unlockedBadges.Value) == "table" then
                                        badgeIds = unlockedBadges.Value
                                    elseif type(unlockedBadges.Value) == "string" then
                                        badgeIds = game:GetService("HttpService"):JSONDecode(unlockedBadges.Value)
                                    end
                                end)
                                local player = game.Players:FindFirstChild(playerFolder.Name)
                                if player and player.Character then
                                    local head = player.Character:FindFirstChild("Head")
                                    if head and not head:FindFirstChild("BadgesESP") then
                                        local badgeCount = 0
                                        for _, id in pairs(badgeIds) do
                                            local idStr = tostring(id)
                                            if badgeNameMap[idStr] then
                                                badgeCount = badgeCount + 1
                                            end
                                        end
                                        if badgeCount > 0 then
