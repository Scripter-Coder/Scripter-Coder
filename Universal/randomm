-- ========== Show Yourself ESP ==========
local yourselfConnection = nil
Tab:Toggle({
    Title = "Show Yourself ESP",
    Value = false,
    Callback = function(Value)
        _G.ShowYourselfESP = Value
        local localPlayer = game.Players.LocalPlayer
        if not Value then
            if yourselfConnection then
                yourselfConnection:Disconnect()
                yourselfConnection = nil
            end
            local character = localPlayer.Character
            if character then
                local head = character:FindFirstChild("Head")
                if head then
                    local nametag = head:FindFirstChild("Nametag")
                    if nametag and nametag:FindFirstChild("Labels") then
                        local topLabel = nametag.Labels:FindFirstChild("TopLabel")
                        if topLabel then
                            topLabel.Visible = true
                        end
                    end
                    if head:FindFirstChild("YourselfESP") then
                        head.YourselfESP:Destroy()
                    end
                end
                if character:FindFirstChild("YourselfESPHighlight") then
                    character.YourselfESPHighlight:Destroy()
                end
            end
            return
        end
        yourselfConnection = game:GetService("RunService").Heartbeat:Connect(function()
            if not _G.ShowYourselfESP then
                return
            end
            local character = localPlayer.Character
            if not character then
                return
            end
            local head = character:FindFirstChild("Head")
            if not head then
                return
            end
            local nametag = head:FindFirstChild("Nametag")
            if nametag and nametag:FindFirstChild("Labels") then
                local topLabel = nametag.Labels:FindFirstChild("TopLabel")
                if topLabel then
                    topLabel.Visible = false
                end
            end
            if not head:FindFirstChild("YourselfESP") then
                local esp = Instance.new("BillboardGui", head)
                esp.Title = "YourselfESP"
                esp.Size = UDim2.new(0, 150, 0, 40)
                esp.StudsOffset = Vector3.new(0, 2, 0)
                esp.AlwaysOnTop = true
                local label = Instance.new("TextLabel", esp)
                label.BackgroundTransparency = 1
                label.Size = UDim2.new(1, 0, 1, 0)
                label.TextSize = 20
                label.Font = Enum.Font.FredokaOne
                label.TextColor3 = Color3.fromRGB(255, 255, 255)
                label.TextStrokeTransparency = 0.2
                label.Text = "You (" .. localPlayer.Name .. ")"
            end
            if not character:FindFirstChild("YourselfESPHighlight") then
                local highlight = Instance.new("Highlight")
                highlight.Title = "YourselfESPHighlight"
                highlight.Adornee = character
                highlight.FillColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.5
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.Parent = character
            end
        end)
    end
})

