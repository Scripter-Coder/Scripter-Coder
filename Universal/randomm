-- Safe set function to prevent errors
local function safeSet(paragraph, content)
    if paragraph and content then
        pcall(function()
            paragraph:Set(content)
        end)
    end
end

-- Killstreak symbols
local function getKillstreakSymbol(kills)
    if kills >= 1000 then return kills .. "🟡⭐"
    elseif kills >= 250 then return kills .. "⚫"
    elseif kills >= 100 then return kills .. "🟡"
    elseif kills >= 75 then return kills .. "🟣"
    elseif kills >= 50 then return kills .. "🔴⚫"
    elseif kills >= 25 then return kills .. "🔵"
    elseif kills >= 10 then return kills .. "🔴"
    else return tostring(kills)
    end
end

-- Get player location
local function getPlayerLocation(player)
    local character = player.Character
    if not character then return "Lobby" end
    
    local workspaceModel = workspace:FindFirstChild(player.Name)
    if workspaceModel and workspaceModel:FindFirstChild("IsInDefaultArena") and workspaceModel.IsInDefaultArena.Value == true then
        return "Default Arena"
    end
    
    if character:FindFirstChild("entered") then
        return "Arena"
    else
        return "Lobby"
    end
end

-- Get player killstreak
local function getPlayerKillstreak(player)
    local workspaceModel = workspace:FindFirstChild(player.Name)
    if workspaceModel and workspaceModel:FindFirstChild("KillstreakLevel") then
        local kills = workspaceModel.KillstreakLevel.Value
        return kills, getKillstreakSymbol(kills)
    end
    return 0, "0"
end

-- Update everything
local isUpdating = false
local function UpdateAllInfo()
    if isUpdating then return end
    isUpdating = true
    
    task.spawn(function()
        pcall(function()
            local me = game.Players.LocalPlayer
            if not me then isUpdating = false; return end
            
            -- My Info
            local myLocation = getPlayerLocation(me)
            local myKills, myKillSymbol = getPlayerKillstreak(me)
            local myText = me.Name .. " In: " .. myLocation .. "\n" .. me.Name .. "'s Killstreak: " .. myKillSymbol
            safeSet(myParagraph, myText)
            
            -- Other Players
            local otherLines = {}
            local otherCount = 0
            
            for _, player in ipairs(game.Players:GetPlayers()) do
                if player ~= me then
                    otherCount = otherCount + 1
                    local location = getPlayerLocation(player)
                    local kills, killSymbol = getPlayerKillstreak(player)
                    table.insert(otherLines, player.Name .. " In: " .. location)
                    table.insert(otherLines, player.Name .. "'s Killstreak: " .. killSymbol)
                    table.insert(otherLines, "")
                end
            end
            
            local otherText = ""
            if otherCount > 0 then
                if otherLines[#otherLines] == "" then
                    table.remove(otherLines)
                end
                otherText = table.concat(otherLines, "\n")
            else
                otherText = "No other players in the server."
            end
            
            safeSet(peopleParagraph, otherText)
        end)
        
        task.wait(0.05)
        isUpdating = false
    end)
end

