-- Auto update every 2 seconds (in case gloves change)
task.spawn(function()
    while true do
        task.wait(2)
        updateGlovesDisplay()
    end
end)

-- Refresh button for gloves
Tab:Button({
    Title = "🔄 Refresh Gloves",
    Callback = function()
        updateGlovesDisplay()
    end
})

