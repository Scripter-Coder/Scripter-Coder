local CandyCornCollector = "Teleport" -- Default fallback
local AutoCollectCandyCorns = false

-- ============================================================
-- BADGE CHECK
-- ============================================================
local NECROMANCER_BADGE_ID = 0 -- replace with the actual Necromancer badge ID
local badgeCache = nil
local badgeCheckedAt = 0

local function hasNecromancerBadge()
    -- Cache the result for 5 seconds so we don't spam the badge API
    if badgeCache ~= nil and tick() - badgeCheckedAt < 5 then
        return badgeCache
    end

    local ok, result = pcall(function()
        return game:GetService("BadgeService"):UserHasBadgeAsync(
            game.Players.LocalPlayer.UserId,
            NECROMANCER_BADGE_ID
        )
    end)

    badgeCache = ok and result == true
    badgeCheckedAt = tick()
    return badgeCache
end

-- ============================================================
-- HELPERS
-- ============================================================
local function getCandyCorns()
    return workspace:FindFirstChild("CandyCorns")
end

-- Returns true if CandyCorns exists and has at least one BasePart inside
local function candyCornsHasParts()
    local candy = getCandyCorns()
    if not candy then return false end
    for _, v in pairs(candy:GetDescendants()) do
        if v:IsA("BasePart") then
            return true
        end
    end
    return false
end

-- ============================================================
-- DROPDOWN
-- ============================================================
Tab:Dropdown({
    Title = "Choose Option To Auto Collect Candy Corns",
    Value = "Teleport",
    Values = {"Teleport", "Bring"},
    Callback = function(Value)
        CandyCornCollector = Value
    end
})

-- ============================================================
-- TOGGLE
-- ============================================================
Tab:Toggle({
    Title = "Auto Collect Candy Corns",
    Value = false,
    Callback = function(Value)
        AutoCollectCandyCorns = Value

        if Value then
            -- Check if player already has the badge
            if hasNecromancerBadge() then
                WindUI:Notify({
                    Title = "Already Have Badge",
                    Content = "You already have Necromancer glove badge! The farm will not work.",
                    Icon = "rbxassetid://7734059095",
                    Duration = 5
                })
                AutoCollectCandyCorns = false
                return
            end

            if CandyCornCollector == "Teleport" then
                task.spawn(function()
                    while AutoCollectCandyCorns do
                        if hasNecromancerBadge() then
                            WindUI:Notify({
                                Title = "Badge Obtained!",
                                Content = "You got the Necromancer glove badge! Farm stopped.",
                                Icon = "rbxassetid://7734059095",
                                Duration = 5
                            })
                            AutoCollectCandyCorns = false
                            break
                        end

                        local character = game.Players.LocalPlayer.Character
                        local hrp = character and character:FindFirstChild("HumanoidRootPart")

                        if hrp and candyCornsHasParts() then
                            local candy = getCandyCorns()
                            local foundCandyCorn = false

                            for _, part in pairs(candy:GetChildren()) do
                                if not AutoCollectCandyCorns then break end

                                if part:IsA("BasePart") then
                                    foundCandyCorn = true
                                    hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
                                    task.wait(0.2)
                                    break
                                end
                            end

                            if not foundCandyCorn then
                                task.wait(0.5)
                            end
                        else
                            task.wait(0.5)
                        end

                        task.wait()
                    end
                end)

            elseif CandyCornCollector == "Bring" then
                task.spawn(function()
                    while AutoCollectCandyCorns do
                        if hasNecromancerBadge() then
                            WindUI:Notify({
                                Title = "Badge Obtained!",
                                Content = "You got the Necromancer glove badge! Farm stopped.",
                                Icon = "rbxassetid://7734059095",
                                Duration = 5
                            })
                            AutoCollectCandyCorns = false
                            break
                        end

                        local character = game.Players.LocalPlayer.Character
                        local hrp = character and character:FindFirstChild("HumanoidRootPart")

                        if hrp and candyCornsHasParts() then
                            local candy = getCandyCorns()

                            for _, part in pairs(candy:GetChildren()) do
                                if not AutoCollectCandyCorns then break end

                                if part:IsA("BasePart") then
                                    part.CFrame = hrp.CFrame
                                end

                                for _, d in pairs(part:GetDescendants()) do
                                    if d:IsA("BasePart") then
                                        d.CFrame = hrp.CFrame
                                    end
                                end
                            end
                        end

                        task.wait(0.1)
                    end
                end)
            end
        end
    end
})

