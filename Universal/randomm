    end
end

-- Get assets from Assets.Obtainments folder
local obtainments = Assets:FindFirstChild("Obtainments")
if obtainments then
    for _, child in ipairs(obtainments:GetChildren()) do
        if child:IsA("Folder") or child:IsA("Model") then
            table.insert(assetOptions, child.Name)
        end
    end
end

-- Get assets from Assets.HeadDecor folder
local headDecor = Assets:FindFirstChild("HeadDecor")
if headDecor then
    for _, child in ipairs(headDecor:GetChildren()) do
        if child:IsA("Folder") or child:IsA("Model") or child:IsA("Part") then
            table.insert(assetOptions, child.Name)
        end
    end
end

-- Remove duplicates
local uniqueOptions = {}
local seen = {}
for _, option in ipairs(assetOptions) do
    if not seen[option] then
        seen[option] = true
        table.insert(uniqueOptions, option)
    end
end

-- Sort alphabetically
table.sort(uniqueOptions)

local selectedAssets = {}

-- Create MultiDropdown for asset selection
Tab:Dropdown({
    Title = "Choose Normal Assets To Replicate",
