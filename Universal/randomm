        if not character then
            WindUI:Notify({
                Title = "Error",
                Content = "Character not found!",
                Icon = "rbxassetid://7743878857",
                Duration = 3
            })
            return
        end
        
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hrp then
            WindUI:Notify({
                Title = "Error",
                Content = "HumanoidRootPart not found!",
                Icon = "rbxassetid://7743878857",
                Duration = 3
            })
            return
        end
        
        -- Search for ingredient directly in workspace
        local ingredient = game.Workspace:FindFirstChild(ingredientName)
        if not ingredient then
            WindUI:Notify({
                Title = "Error",
                Content = ingredientName .. " not found in workspace!",
                Icon = "rbxassetid://7743878857",
                Duration = 3
            })
            return
        end
        
        -- Find a BasePart inside the Model
        local function findBasePart(model)
            -- Check if the model itself is a BasePart
            if model:IsA("BasePart") then
                return model
            end
            
            -- Search through all children for a BasePart
            for _, child in ipairs(model:GetChildren()) do
                if child:IsA("BasePart") then
                    return child
                end
                -- If child is a Model, search inside it too
                if child:IsA("Model") then
                    local found = findBasePart(child)
                    if found then
                        return found
                    end
                end
            end
            return nil
        end
        
        local targetPart = findBasePart(ingredient)
        if not targetPart then
            WindUI:Notify({
                Title = "Error",
                Content = "No BasePart found inside " .. ingredientName .. "!",
                Icon = "rbxassetid://7743878857",
                Duration = 3
            })
            return
        end
        
        -- Teleport to the BasePart
        pcall(function()
            hrp.CFrame = CFrame.new(targetPart.Position + Vector3.new(0, 5, 0))
            WindUI:Notify({
                Title = "Success",
                Content = "Teleported to " .. ingredientName .. "!",
                Icon = "rbxassetid://7743878857",
