local glovesParagraph = nil

-- Function to get formatted gloves list with two sections
local function getFormattedGlovesList()
    local player = Players.LocalPlayer
    local unlockedGlovesFolder = player:FindFirstChild("_unlockedGloves")
    
    if not unlockedGlovesFolder then
        return "❌ _unlockedGloves folder not found!"
    end
    
    local unlockedGloves = {}  -- Owned (true)
    local lockedGloves = {}    -- Not owned (false)
    
    -- Separate gloves into unlocked and locked
    for _, glove in ipairs(unlockedGlovesFolder:GetChildren()) do
        if glove:IsA("BoolValue") then
            if glove.Value then
                table.insert(unlockedGloves, glove.Name)
            else
                table.insert(lockedGloves, glove.Name)
            end
        end
    end
    
    -- Sort alphabetically
    table.sort(unlockedGloves)
    table.sort(lockedGloves)
    
    -- Build formatted output
    local result = ""
    
    -- UNLOCKED GLOVES SECTION (Owned)
    result = result .. "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    result = result .. "                 🟢 GLOVES UNLOCKED 🟢\n"
    result = result .. "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    result = result .. "Total: " .. #unlockedGloves .. " gloves owned\n\n"
    
    if #unlockedGloves > 0 then
        for _, gloveName in ipairs(unlockedGloves) do
            result = result .. "✅ " .. gloveName .. "\n"
        end
    else
        result = result .. "❌ No gloves owned yet\n"
    end
    
    -- LOCKED GLOVES SECTION (Not owned)
    result = result .. "\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    result = result .. "                 🔴 GLOVES LOCKED 🔴\n"
    result = result .. "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    result = result .. "Total: " .. #lockedGloves .. " gloves locked\n\n"
    
    if #lockedGloves > 0 then
        for _, gloveName in ipairs(lockedGloves) do
            result = result .. "❌ " .. gloveName .. "\n"
        end
    else
        result = result .. "✅ All gloves unlocked!\n"
    end
    
    -- STATISTICS
    local totalGloves = #unlockedGloves + #lockedGloves
    local ownedCount = #unlockedGloves
    
    result = result .. "\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    result = result .. "                    📊 STATISTICS 📊\n"
    result = result .. "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    result = result .. "✅ Unlocked: " .. ownedCount .. "/" .. totalGloves .. "\n"
    result = result .. "❌ Locked: " .. (#lockedGloves) .. "/" .. totalGloves .. "\n"
    result = result .. "📈 Progress: " .. string.format("%.1f", (ownedCount / totalGloves) * 100) .. "%\n"
    
    return result
end

-- Function to update gloves display
local function updateGlovesDisplay()
    if glovesParagraph then
        local text = getFormattedGlovesList()
        glovesParagraph:SetDesc(text)
    end
end

-- Create the paragraph
glovesParagraph = Tab:Paragraph({Title = "Gloves Unlocked/Locked List:", Desc = "Loading gloves..."})

-- Initial display
