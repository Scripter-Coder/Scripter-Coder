-- Function to extract number from slap text (e.g., "50,000 Slaps" -> 50000)
local function extractSlapNumber(slapText)
	if slapText == "???" then return math.huge end
	local num = slapText:match("([%d,]+)")
	if num then
		num = num:gsub(",", "")
		return tonumber(num) or math.huge
	end
	return math.huge
end

-- Sort gloves by slap requirement (lowest to highest)
table.sort(glovesList, function(a, b)
	local numA = extractSlapNumber(a.slapText)
	local numB = extractSlapNumber(b.slapText)
	return numA < numB
end)

