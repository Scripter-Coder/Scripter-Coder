-- Function to check a single gamepass using MarketplaceService (NO JSON!)
local function checkGamepassOwned(gamepassId)
    local success, owned = pcall(function()
        return MarketplaceService:UserOwnsGamePassAsync(localPlayer.UserId, gamepassId)
    end)
    return success and owned or false
end

-- Function to fetch all owned gamepasses (NO JSON!)
local function fetchOwnedGamepasses()
    if isFetchingGamepasses then return false end
    isFetchingGamepasses = true
    
    local newOwned = {}
    local total = #allGamepasses
    local checked = 0
    
    for _, gamepass in ipairs(allGamepasses) do
        local isOwned = checkGamepassOwned(gamepass.id)
        newOwned[gamepass.id] = isOwned
        checked = checked + 1
        
        -- Rate limit to avoid throttling
        if checked % 3 == 0 then
            task.wait(0.1)
        end
    end
    
    ownedGamepasses = newOwned
    isFetchingGamepasses = false
    return true
end

