local function addGloveDetectorButtons(tab, gloveName)
 tab:Button({Title = "Someone Using " .. gloveName .. "?", Callback = function()
  local found = false
  for _, player in ipairs(game.Players:GetPlayers()) do
   local stats = player:FindFirstChild("leaderstats")
   local glove = stats and stats:FindFirstChild("Glove")
   if glove and glove.Value == gloveName then
    found = true
    WindUI:Notify({Title = "Detected!", Content = player.Name .. " has equipped the " .. gloveName .. " glove.", Icon = "rbxassetid://7733715400", Duration = 3})
   end
  end
  if not found then notifyErr("No one has equipped the " .. gloveName .. " glove") end
 end})
 tab:Button({Title = "Teleport To " .. gloveName .. " Player", Callback = function()
  local localPlayer = game.Players.LocalPlayer
  local foundPlayer = nil
  for _, player in pairs(game.Players:GetPlayers()) do
   if player ~= localPlayer then
    local stats = player:FindFirstChild("leaderstats")
    if stats and stats:FindFirstChild("Glove") and stats.Glove.Value == gloveName then
     foundPlayer = player
     break
    end
   end
  end
  if foundPlayer and foundPlayer.Character and foundPlayer.Character:FindFirstChild("HumanoidRootPart") then
   localPlayer.Character:PivotTo(foundPlayer.Character.HumanoidRootPart.CFrame + Vector3.new(0, 5, 0))
   WindUI:Notify({Title = "Success!", Content = "Teleported To: " .. foundPlayer.Name, Icon = "rbxassetid://7733715400", Duration = 3})
  else
   notifyErr(gloveName .. " Player Not Found")
  end
 end})
end

