function Items.StartCrateWatcher()
    if Items.CrateWatcherStarting then return end
    Items.CrateWatcherStarting = true
    task.spawn(function()
        while Items.FastCollectCratesEnabled or Items.CrateAuraEnabled do
            Items.RefreshCrates()
            task.wait(1)
        end
        Items.CrateWatcherStarting = false
    end)
end

function Items.ScanCratesNow() Items.RefreshCrates() end

function Items.TryStartAutoCollectCrates()
    local now = os.clock()
    if now - Items.AutoCollectCratesLastStart < Items.AutoCollectCratesStartCooldown then return end
    Items.AutoCollectCratesLastStart = now
    if #Items.Crates > 0 and not Items.CollectCratesBusy then task.defer(Items.CollectCrates) end
end

function Items.StartFastCollectCrates()
    if Items.FastCollectCratesThread then return end
    Items.FastCollectCratesThread = task.spawn(function()
        while Items.FastCollectCratesEnabled do
            local character = player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            Items.UpdateFastCollectCratesBox(root)
            if not Items.CollectCratesBusy then
                for _, cratePart in ipairs(Items.GetTrackedCrateParts(root)) do
                    if not Items.FastCollectCratesEnabled then break end
                    Items.SlapCrate(cratePart)
                end
            end
            task.wait(Items.FastCollectCratesInterval)
        end
        Items.FastCollectCratesThread = nil
    end)
end

function Items.StartCrateAura()
    if Items.CrateAuraThread then return end
    Items.CrateAuraThread = task.spawn(function()
        while Items.CrateAuraEnabled do
            local character = player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            if root then
                for _, cratePart in ipairs(Items.GetTrackedCrateParts(root)) do
                    if not Items.CrateAuraEnabled then break end
                    Items.SlapCrate(cratePart)
                end
            end
            task.wait(Items.CrateAuraInterval)
        end
        Items.CrateAuraThread = nil
    end)
end

function Items.UpdateFastCollectCratesBox(root)
    if not Items.FastCollectCratesEnabled or not root or not root.Parent then
        Items.ClearFastCollectCratesBox()
        return nil
    end
    local box = Items.FastCollectCratesBox
    if not box or not box.Parent then
        box = Instance.new("Part")
        box.Title = "Part"
        box.Size = Items.FastCollectCratesBoxSize
        box.Anchored = true
        box.CanCollide = false
        box.CanTouch = false
        box.CanQuery = false
        box.Transparency = 1
        box.Color = Color3.fromRGB(255, 64, 64)
        box.Material = Enum.Material.Neon
        box.Parent = workspace
        Items.FastCollectCratesBox = box
    end
    box.Size = Items.FastCollectCratesBoxSize
    box.CFrame = root.CFrame
    return box
end

function Items.IsCratePartInFastCollectBox(cratePart, root)
    if not cratePart or not cratePart.Parent or not root or not root.Parent then return false end
    local relativePosition = root.CFrame:PointToObjectSpace(cratePart.Position)
    local halfSize = Items.FastCollectCratesBoxSize / 2
    return math.abs(relativePosition.X) <= halfSize.X
        and math.abs(relativePosition.Y) <= halfSize.Y
        and math.abs(relativePosition.Z) <= halfSize.Z
end

function Items.GetTrackedCrateParts(root)
    local parts = {}
    local seen = {}
    if os.clock() - (Items.FastCollectCratesLastScan or 0) >= Items.FastCollectCratesScanInterval then
        Items.FastCollectCratesLastScan = os.clock()
        Items.ScanCratesNow()
    else
        Items.RefreshCrates()
    end
    for _, crate in ipairs(Items.Crates) do
        local part = Items.GetCratePart(crate)
        if part and (not root or Items.IsCratePartInFastCollectBox(part, root)) then
            seen[crate] = true
            table.insert(parts, part)
        end
    end
    return parts
end

function Items.ClearFastCollectCratesBox()
    if Items.FastCollectCratesBox then
        pcall(function() Items.FastCollectCratesBox:Destroy() end)
        Items.FastCollectCratesBox = nil
    end
    table.clear(Items.FastCollectCratesNearbyCache)
    table.clear(Items.CratePartCache)
    table.clear(Items.CrateFireCache)
    table.clear(Items.CrateUsedCache)
    Items.FastCollectCratesLastNearbyScan = 0
end

function Items.CleanupAutomation()
    if Items.AutoCollectThread then task.cancel(Items.AutoCollectThread); Items.AutoCollectThread = nil end
    if Items.AutoPickupThread then task.cancel(Items.AutoPickupThread); Items.AutoPickupThread = nil end
    if Items.EarlyAutoCollectThread then task.cancel(Items.EarlyAutoCollectThread); Items.EarlyAutoCollectThread = nil end
    if Items.FastCollectCratesThread then task.cancel(Items.FastCollectCratesThread); Items.FastCollectCratesThread = nil end
    if Items.CrateAuraThread then task.cancel(Items.CrateAuraThread); Items.CrateAuraThread = nil end
    Items.ClearFastCollectCratesBox()
    Items.ClearSearchRootConnections()
end

-- ============ COMBAT FUNCTIONS ============
local Combat = {
    HitboxMinSize = 1,
    HitboxMaxSize = 20,
    HitboxSize = 1.5,
    HitboxExpanded = false,
    HitboxVisible = false,
    SavedHitboxes = {},
    SlapAuraEnabled = false,
    SlapAuraThread = nil,
    SlapAuraInterval = 0.2,
    AutoGloveTapEnabled = false,
    AutoGloveTapThread = nil,
    AntiSlapEnabled = false,
    AntiSlapThread = nil
}

function Combat.GetSlapRemote()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes then
        local remote = remotes:FindFirstChild("Slap")
        if remote and remote:IsA("RemoteEvent") then return remote end
    end
    for _, obj in ipairs(ReplicatedStorage:GetChildren()) do
        if obj.Title == "Slap" and obj:IsA("RemoteEvent") then return obj end
    end
    return nil
end

function Combat.GetSlapTargets()
    local targets = {}
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return targets end
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player then
            local targetRoot = Combat.GetPlayerRoot(targetPlayer)
            local humanoid = Combat.GetPlayerHumanoid(targetPlayer)
            if targetRoot and humanoid and humanoid.Health > 0 then
                if not Teleport.IsLocalRagdolled(targetPlayer.Character, humanoid) then
                    local dist = (root.Position - targetRoot.Position).Magnitude
                    if dist < Combat.HitboxSize * 1.5 then
                        table.insert(targets, targetRoot)
                    end
                end
            end
        end
    end
    return targets
end

function Combat.StartSlapAura()
    if Combat.SlapAuraThread then return end
    Combat.SlapAuraThread = task.spawn(function()
        local remote = Combat.GetSlapRemote()
        if not remote then
            while not remote and Combat.SlapAuraEnabled do
                remote = Combat.GetSlapRemote()
                if remote then break end
                task.wait(1)
            end
            if not remote then
                createNotification("Slap Aura", "Slap remote not found! Disabling.", "Error")
                Combat.SlapAuraEnabled = false
                return
            end
        end
        while Combat.SlapAuraEnabled do
            local targets = Combat.GetSlapTargets()
            for _, targetRoot in ipairs(targets) do
                pcall(function() remote:FireServer(targetRoot) end)
            end
            task.wait(Combat.SlapAuraInterval or 0.15)
        end
        Combat.SlapAuraThread = nil
    end)
end

function Combat.SetSlapAura(state, silent)
    Combat.SlapAuraEnabled = state == true
    if Combat.SlapAuraEnabled then
        Combat.StartSlapAura()
        if not silent then createNotification("Slap Aura", "Slap Aura enabled.", "Success") end
    else
        if Combat.SlapAuraThread then
            task.cancel(Combat.SlapAuraThread)
            Combat.SlapAuraThread = nil
        end
        if not silent then createNotification("Slap Aura", "Slap Aura disabled.") end
    end
end

function Combat.GetPlayerRoot(targetPlayer)
    local character = targetPlayer.Character
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
end

function Combat.GetPlayerHumanoid(targetPlayer)
    local character = targetPlayer.Character
    if not character then return nil end
    return character:FindFirstChildOfClass("Humanoid")
end

function Combat.SaveOriginalHitbox(otherPlayer, root)
    if Combat.SavedHitboxes[otherPlayer] then return end
    Combat.SavedHitboxes[otherPlayer] = {
        Size = root.Size,
        Transparency = root.Transparency,
        Color = root.Color,
        Material = root.Material,
        CanCollide = root.CanCollide
    }
end

function Combat.ResetHitbox(otherPlayer)
    local character = otherPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local saved = Combat.SavedHitboxes[otherPlayer]
    if root and saved then
        root.Size = saved.Size
        root.Transparency = saved.Transparency
        root.Color = saved.Color
        root.Material = saved.Material
        root.CanCollide = saved.CanCollide
    end
    Combat.SavedHitboxes[otherPlayer] = nil
end

function Combat.ApplyHitbox(otherPlayer)
    local character = otherPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        Combat.ResetHitbox(otherPlayer)
        return
    end
    Combat.SaveOriginalHitbox(otherPlayer, root)
    root.Size = Vector3.new(Combat.HitboxSize, Combat.HitboxSize * 1.5, Combat.HitboxSize)
    root.Transparency = Combat.HitboxVisible and 0.5 or 1
    root.Color = Color3.fromRGB(255, 0, 0)
    root.Material = Enum.Material.Neon
    root.CanCollide = false
end

function Combat.SetHitboxSize(value)
    Combat.HitboxSize = math.clamp(value, Combat.HitboxMinSize, Combat.HitboxMaxSize)
    Combat.RefreshHitboxes()
end

function Combat.SetHitboxExpanded(state)
    Combat.HitboxExpanded = state == true
    Combat.RefreshHitboxes()
end

function Combat.SetHitboxVisible(state)
    Combat.HitboxVisible = state == true
    Combat.RefreshHitboxes()
end

function Combat.RefreshHitboxes()
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player then Combat.ResetHitbox(targetPlayer) end
    end
    if not Combat.HitboxExpanded then return end
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player then
            local character = targetPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                Combat.ApplyHitbox(targetPlayer)
            end
        end
    end
end

Players.PlayerAdded:Connect(function(otherPlayer)
    task.wait(0.5)
    if Combat.HitboxExpanded then Combat.ApplyHitbox(otherPlayer) end
end)

Players.PlayerRemoving:Connect(function(otherPlayer)
    Combat.ResetHitbox(otherPlayer)
end)

function Combat.TeleportToPlayer(targetPlayer)
    if not targetPlayer then
        createNotification("Teleport", "Player not found.", "Error")
        return
    end
    local character = targetPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then
        createNotification("Teleport", "Player character not found.", "Error")
        return
    end
    local localChar = player.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if not localRoot then
        createNotification("Teleport", "Your character not found.", "Error")
        return
    end
    local targetPos = root.Position + (root.CFrame.LookVector * -3) + Vector3.new(0, 2, 0)
    local groundCFrame = Teleport.GetGroundCFrame(targetPos, { localChar, character })
    Teleport.MoveRoot(localRoot, groundCFrame)
    Teleport.AddStrike()
    Teleport.StartFBlock()
    createNotification("Teleport", "Teleported to " .. targetPlayer.Name)
end

function Combat.TeleportToNearestPlayer()
    local nearest = nil
    local nearestDist = math.huge
    local localChar = player.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if not localRoot then
        createNotification("Teleport", "Your character not found.", "Error")
        return
    end
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player then
            local character = targetPlayer.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            if root then
                local dist = (localRoot.Position - root.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                    nearest = targetPlayer
                end
            end
        end
    end
    if nearest then
        Combat.TeleportToPlayer(nearest)
    else
        createNotification("Teleport", "No players found.", "Warning")
    end
end

function Combat.TeleportToLowestHealthPlayer()
    local lowest = nil
    local lowestHealth = math.huge
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player then
            local character = targetPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                if humanoid.Health < lowestHealth then
                    lowestHealth = humanoid.Health
                    lowest = targetPlayer
                end
            end
        end
    end
    if lowest then
        Combat.TeleportToPlayer(lowest)
    else
        createNotification("Teleport", "No valid players found.", "Warning")
    end
end

