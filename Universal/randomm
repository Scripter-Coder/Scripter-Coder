local function equipglove(gloveName)
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        local tool = backpack:FindFirstChild(gloveName)
        if tool then
            LocalPlayer.Character.Humanoid:EquipTool(tool)
            return true
        end
    end
    local character = LocalPlayer.Character
    if character then
        local tool = character:FindFirstChild(gloveName)
        if tool then
            return true
        end
    end
    return false
end

local function slapglove(targetPart)
    local generalHit = ReplicatedStorage:FindFirstChild("GeneralHit")
    if generalHit and targetPart then
        generalHit:FireServer(targetPart)
        return true
    end
    return false
end

local function CreateFreezeBV(remove)
    local character = LocalPlayer.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    if remove then
        local bv = rootPart:FindFirstChild("FreezeBV")
        if bv then bv:Destroy() end
        return
    end
    
    local existing = rootPart:FindFirstChild("FreezeBV")
    if existing then existing:Destroy() end
    
    local bv = Instance.new("BodyVelocity")
    bv.Title = "FreezeBV"
    bv.P = 10000
    bv.MaxForce = Vector3.new(1e6, 0, 1e6)
    bv.Velocity = Vector3.zero
    bv.Parent = rootPart
    
    return bv
end

local function firetouchinterest(part1, part2, touchState)
    if not part1 or not part2 then return end
    local touchEvent = part1.TouchInterest
    if not touchEvent then return end
    touchEvent:FireServer(part2, touchState)
end

