local function getCandyCorns()
    return workspace:FindFirstChild("CandyCorns")
end

-- Returns true if CandyCorns exists and has at least one BasePart inside
local function candyCornsHasParts()
    local candy = getCandyCorns()
    if not candy then return false end
    for _, v in pairs(candy:GetDescendants()) do
        if v:IsA("BasePart") then
            return true
        end
    end
    return false
end

