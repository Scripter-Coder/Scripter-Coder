-- Function to start crafting
local function startCrafting()
    if #selectedPotions == 0 then
        WindUI:Notify({
            Title = "Error",
            Content = "Select at least one potion/cake to craft!",
            Icon = "rbxassetid://7743878857",
            Duration = 3
        })
        return false
    end
    
    totalCraftedCount = 0
    
    for i = 1, craftCount do
        -- Break if auto crafting was stopped
        if isAutoCrafting and not autoCraftLoop then
            break
        end
        
        for _, potionName in ipairs(selectedPotions) do
            -- Break if auto crafting was stopped or reached craft count
            if isAutoCrafting and not autoCraftLoop then
                break
            end
            
            if totalCraftedCount >= craftCount then
                break
            end
            
            local success = craftPotion(potionName)
            if success then
                totalCraftedCount = totalCraftedCount + 1
                print("✅ Crafted: " .. potionName .. " (" .. totalCraftedCount .. "/" .. craftCount .. ")")
            end
        end
        
        -- Check if reached craft count
        if totalCraftedCount >= craftCount then
            break
        end
    end
    
    -- If auto crafting, stop it
    if isAutoCrafting then
        isAutoCrafting = false
        if autoCraftLoop then
            task.cancel(autoCraftLoop)
            autoCraftLoop = nil
        end
    end
    
    WindUI:Notify({
        Title = "Complete",
        Content = "Crafted " .. totalCraftedCount .. " potions/cakes!",
        Icon = "rbxassetid://7743878857",
        Duration = 5
    })
    
    return true
end

