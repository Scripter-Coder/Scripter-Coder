    }
    local encoded = HttpService:JSONEncode(data)
    pcall(function()
        if type(setclipboard) == "function" then setclipboard(encoded)
        elseif type(writefile) == "function" then writefile("OPSlapRoyale_Preferences.json", encoded) end
    end)
end

function loadPreferences()
    pcall(function()
        local data = nil
        if type(readfile) == "function" then
            local content = readfile("OPSlapRoyale_Preferences.json")
            if content and content ~= "" then data = HttpService:JSONDecode(content) end
        end
        if not data then
            local clipboard = nil
            if type(getclipboard) == "function" then clipboard = getclipboard() end
            if clipboard and clipboard ~= "" then
                local success, decoded = pcall(function() return HttpService:JSONDecode(clipboard) end)
                if success and decoded then data = decoded end
            end
        end
        if data then
            if data.Toggles then for k, v in pairs(data.Toggles) do Preferences.Toggles[k] = v end end
            if data.Sliders then for k, v in pairs(data.Sliders) do Preferences.Sliders[k] = v end end
            if data.Dropdowns then for k, v in pairs(data.Dropdowns) do Preferences.Dropdowns[k] = v end end
            if data.Inputs then for k, v in pairs(data.Inputs) do Preferences.Inputs[k] = v end end
            if data.Theme then Preferences.Theme = data.Theme end
            if data.TeleportMenuOpen ~= nil then Preferences.TeleportMenuOpen = data.TeleportMenuOpen end
            if data.TeleportMenuTab then Preferences.TeleportMenuTab = data.TeleportMenuTab end
            if data.CustomStrikes then Preferences.CustomStrikes = data.CustomStrikes; Teleport.MaxStrikes = data.CustomStrikes end
            if data.CustomTPDebounce then Preferences.CustomTPDebounce = data.CustomTPDebounce; Teleport.Debounce = data.CustomTPDebounce end
            if data.CustomFLock then Preferences.CustomFLock = data.CustomFLock; Teleport.PostFLock = data.CustomFLock end
        end
    end)
end

