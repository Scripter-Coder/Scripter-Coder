    Multi = true,
    AllowNone = true,
    Callback = function(Values)
        selectedAssets = Values
    end
})

-- Function to get the full path of an asset
local function getAssetPath(assetName)
    -- Check in Assets folder
    local asset = Assets:FindFirstChild(assetName)
    if asset then
        return asset
    end
    
    -- Check in Assets.Obtainments
    local obtainments = Assets:FindFirstChild("Obtainments")
    if obtainments then
        asset = obtainments:FindFirstChild(assetName)
        if asset then
            return asset
        end
    end
    
    -- Check in Assets.HeadDecor
    local headDecor = Assets:FindFirstChild("HeadDecor")
    if headDecor then
        asset = headDecor:FindFirstChild(assetName)
        if asset then
            return asset
        end
    end
    
    return nil
end

-- Create or get the folder for replicated assets
local function getReplicatedFolder()
    local folder = game.Workspace:FindFirstChild("AbyssAssets")
    if not folder then
        folder = Instance.new("Folder")
        folder.Title = "AbyssAssets"
        folder.Parent = game.Workspace
    end
    return folder
end

-- Replicate Normal Assets button
Tab:Button({
    Title = "Replicate Normal Assets",
    Callback = function()
        if #selectedAssets == 0 then
            warn("No assets selected!")
            return
        end
        
        local folder = getReplicatedFolder()
        
        for _, assetName in ipairs(selectedAssets) do
            local asset = getAssetPath(assetName)
            if asset then
                -- Clone the asset
                local clone = asset:Clone()
                clone.Parent = folder
                
                -- Position it randomly in the workspace
                local randomX = math.random(-100, 100)
                local randomZ = math.random(-100, 100)
                local randomY = math.random(0, 50)
                
                -- If it's a model, set primary part position
                if clone:IsA("Model") and clone.PrimaryPart then
                    clone:SetPrimaryPartCFrame(CFrame.new(randomX, randomY, randomZ))
                elseif clone:IsA("Model") then
                    -- If no primary part, move all parts
                    for _, part in ipairs(clone:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CFrame = part.CFrame + Vector3.new(randomX, randomY, randomZ)
                        end
                    end
                elseif clone:IsA("BasePart") then
                    clone.CFrame = CFrame.new(randomX, randomY, randomZ)
                end
            end
        end
        
        print("Replicated " .. #selectedAssets .. " assets to workspace!")
    end
})

