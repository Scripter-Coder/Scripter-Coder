        local code = 1118 + ((playerCount - 1) * 25) -- 1118 + (n-1)*25
        
        -- Camera view
        local originalSubject = workspace.CurrentCamera.CameraSubject
        local originalCF = workspace.CurrentCamera.CFrame
        
        -- Look at keypad
        local backpiece = keypad:FindFirstChild("Backpiece")
        if backpiece then
            workspace.CurrentCamera.CameraSubject = backpiece
        end
        
        -- Get buttons
        local buttons = keypad:FindFirstChild("Buttons")
        if not buttons then
            WindUI:Notify({
