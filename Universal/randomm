local function containsKeyword(message)
    local lower = message:lower()
    for _, kw in ipairs(keywords) do
        if lower:match(kw:lower()) then return true, kw end
    end
    return false, nil
end

local function onPlayerChat(speaker, message)
    if not _G.AntiRecord then return end
    local found, kw = containsKeyword(message)
