            return game:GetService("HttpService"):JSONDecode(questData)
        end)
        
        if not success then
            WindUI:Notify({
                Title = "Error",
                Content = "Failed to parse quest data",
                Icon = "rbxassetid://4483345998",
                Duration = 5
            })
            return
